+      if (total >= 4) expect(strong / total).toBeGreaterThanOrEqual(0.6);
+    }
+  });
+
+  it('adjacent chords share required common tones (Rule 25)', () => {
+    const p = makeProject(STANDARD);
+    p.chords = generateProgression(p, { seed: 8 });
+    for (const s of p.sections) {
+      const list = chordsIn(p, s).map((c) => P(c.symbol));
+      for (let i = 1; i < list.length; i++) {
+        const a = list[i - 1], b = list[i];
+        const dm = ((b.root - a.root) % 12 + 12) % 12;
+        const shared = a.pitchClasses.filter((x) => b.pitchClasses.includes(x)).length;
+        if (dm === 5 || dm === 7) expect(shared, `${a.symbol}->${b.symbol}`).toBeGreaterThanOrEqual(1);
+        if ([3, 4, 8, 9].includes(dm)) expect(shared, `${a.symbol}->${b.symbol}`).toBeGreaterThanOrEqual(2);
+      }
+    }
+  });
+
+  it('no identical chord symbol holds more than 2 bars outside intro/breakdown (Rule 23)', () => {
+    const p = makeProject([sec('Verse', 1, 8), sec('Chorus', 9, 8)]);
+    p.chords = generateProgression(p, { seed: 4 });
+    for (const s of p.sections) {
+      let runSym = '', runStart = 0;
+      for (const c of chordsIn(p, s)) {
+        if (c.symbol === runSym) {
+          const span = (c.startTick + c.durationTicks - runStart) / barT(p);
+          expect(span, `${runSym} holds ${span} bars`).toBeLessThanOrEqual(2.001);
+        } else { runSym = c.symbol; runStart = c.startTick; }
+      }
+    }
+  });
+
+  it('borrowing is capped and never on bar 1 (Rules 38/39)', () => {
+    const p = makeProject([sec('Verse', 1, 8), sec('Bridge', 9, 4), sec('Chorus', 13, 8)]);
+    p.chords = generateProgression(p, { seed: 13 });
+    const scalePcs = new Set(MODES.Dorian.map((i) => (2 + i) % 12));
+    for (const s of p.sections) {
+      let borrowed = 0;
+      for (const c of chordsIn(p, s)) {
+        const r = P(c.symbol);
+        // Cadential raised-leading-tone V7 is cap-exempt (Rules 10/29: "unless cadencing").
+        const isCadentialDominant = r.root === (2 + MODES.Dorian[4]) % 12 && ['major', '7'].includes(r.quality);
+        const isBorrowed = !isCadentialDominant && !r.pitchClasses.every((x) => scalePcs.has(x));
+        if (isBorrowed) {
+          borrowed++;
+          const barIdx = Math.floor((c.startTick - (s.startBar - 1) * barT(p)) / barT(p));
+          expect(barIdx, `${r.symbol} at bar index ${barIdx} of ${s.name}`).toBeGreaterThanOrEqual(1);
+        }
+      }
+      expect(borrowed, `${s.name} borrowed count`).toBeLessThanOrEqual(Math.max(1, Math.round(s.lengthBars / 4)));
+    }
+  });
+
+  it('exotic modes follow their strategies (Rules 18-20)', () => {
+    const wt = makeProject(STANDARD, { mode: 'Whole Tone' });
+    wt.chords = generateProgression(wt, { seed: 6 });
+    expect(wt.chords.length).toBeGreaterThan(0);
+    for (const c of wt.chords) {
+      const r = parseChord(c.symbol);
+      expect(r.ok).toBe(true);
+      if (r.ok) expect(['augmented', '7']).toContain(r.chord.quality);
+    }
+    const wh = makeProject(STANDARD, { mode: 'Diminished (Whole-Half)' });
+    wh.chords = generateProgression(wh, { seed: 6 });
+    for (const c of wh.chords) {
+      const r = parseChord(c.symbol);
+      expect(r.ok).toBe(true);
+      if (r.ok) expect(['dim7', '7']).toContain(r.chord.quality);
+    }
+  });
+
+  it("mode 'empty' preserves existing chords and fills only gaps", () => {
+    const p = makeProject(STANDARD);
+    const bt = barT(p);
+    const existing: Chord[] = [
+      { id: 'keep1', symbol: 'Dm', startTick: 0, durationTicks: 2 * bt },
+      { id: 'keep2', symbol: 'Gm', startTick: 8 * bt, durationTicks: bt },
+    ];
+    p.chords = existing; // the generator must see the chords it has to preserve
+    const out = generateProgression(p, { seed: 9, mode: 'empty' });
+    expect(out.find((c) => c.id === 'keep1')?.symbol).toBe('Dm');
+    expect(out.find((c) => c.id === 'keep2')?.symbol).toBe('Gm');
+    const others = out.filter((c) => c.id !== 'keep1' && c.id !== 'keep2');
+    for (const c of others) {
+      const overlapsKeep = (k: Chord) => c.startTick < k.startTick + k.durationTicks && c.startTick + c.durationTicks > k.startTick;
+      expect(overlapsKeep(existing[0]), `generated ${c.symbol}@${c.startTick} overlaps kept chord`).toBe(false);
+      expect(overlapsKeep(existing[1])).toBe(false);
+    }
+  });
+
+  it('profile routing picks sensible section keys', () => {
+    expect(resolveProfileKey('Intro')).toBe('intro');
+    expect(resolveProfileKey('Pre-Chorus')).toBe('prechorus');
+    expect(resolveProfileKey('Build Up')).toBe('build');
+    expect(resolveProfileKey('chorus 2')).toBe('chorus');
+    expect(resolveProfileKey('Breakdown')).toBe('breakdown');
+    expect(resolveProfileKey('Mosh Pit')).toBe('verse');
