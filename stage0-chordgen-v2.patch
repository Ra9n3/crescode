+/**
+ * ============================================================================
+ *  CRESCODE STAGE 0 — CHORD PROGRESSION GENERATOR ("Generate Progression")
+ * ============================================================================
+ * Implements the Round-1 rule set (45 rules, NotebookLM-sourced from 16 books,
+ * red-teamed 2026-10-28). Rule numbers below reference that set.
+ *
+ * Red-team adaptations baked in (deviations are documented here, not hidden):
+ *  - Rule 34 tension metric formalized: Diss from chord class (verified against
+ *    the published worked examples G7 = 0.46, A7b9 = 0.75, Dm = 0.00),
+ *    Dist_Tonic = ((root - tonic) mod 12) / 12 (recovered from the examples).
+ *    Rule 36's example "Dm (T=0.35)" contradicted its own metric — the metric
+ *    is the single source of truth and curve checks use the metric.
+ *  - Rule 5 vs Rule 36 release conflict: releases sit every 4th bar, not
+ *    "every 2 bars".
+ *  - Rule 4 vs Rule 35 Build start conflict: Build start tension inherits the
+ *    curve (target start 0.60, end >= 0.85, monotonic) — no absolute 0.65 start.
+ *  - Rule 40 resolution window: "resolve within 2 beats" is impossible at
+ *    1 chord/bar and contradicts Rule 6's own example; adapted to "borrowed
+ *    chord resolves to a diatonic chord in the next slot". Voice-level motion
+ *    checks belong to the voicing stage (Round 2), not here.
+ *  - Rule 3 + Rule 30 double-dominant: only the section directly before a
+ *    Chorus carries the mandatory dominant exit; earlier exits are preferred.
+ *  - Rule 27 was tagged SHOULD but Rule 44 lists it as Tier 1: downbeat
+ *    alignment is enforced (MUST); the 75%/25% ratios remain scoring targets.
+ *  - Rule 45 timing jitter: rejected — chords stay grid-exact; the seed varies
+ *    content only (archetype, chord choice, borrowing). Humanize is stage 11.
+ *  - Rule 44's fuzzy "score delta 0.15" formalized: cadences / metric
+ *    alignment / root-motion safety are hard filters; tension curves and
+ *    density are soft scores; 0.15 is the near-best tie band when picking.
+ *  - Compound meters: Tutti is capped at 2 chords/bar (Rule 28 allows changes
+ *    only on felt beats, so 4/bar is impossible in 6/8).
+ *  - Exotic modes per Rules 18-20: Whole Tone = aug/7b5 planing (common-tone
+ *    rule off — aug triads a 2nd apart share no tones); Diminished W-H / H-W =
+ *    7b9 and dim7 chords on the m3 stack, motion by 3 semitones.
+ *
+ * Engineering invariants (unchanged): deterministic from (seed, project),
+ * no Math.random, every emitted symbol must pass parseChord, chords sit
+ * inside their section and never overlap, existing chords can be preserved.
+ */
+import { parseChord, type ParsedChord } from '../shared/schema/chords';
+import { beatOffsets, beatTicks, barTicks, isCompound } from '../shared/schema/meter';
+import { MODES, NOTE_NAMES } from '../shared/schema/modes';
+import { hashString, mulberry32 } from '../engine/generate';
+import { uid } from '../shared/schema/factory';
+import type { Chord, ModeName, Project, Section, TimeSignature } from '../shared/schema/types';
+
+export interface ProgressionOptions {
+  seed: number;
+  /** 'all' replaces the chord track; 'empty' fills gaps around existing chords. */
+  mode?: 'all' | 'empty';
+}
+
+/* ============================ Tension metric (Rule 34) ============================ */
+
+function hasTritone(pcs: number[]): boolean {
+  for (let i = 0; i < pcs.length; i++) for (let j = i + 1; j < pcs.length; j++) if ((pcs[i] - pcs[j] + 12) % 12 === 6) return true;
+  return false;
+}
+
+/** Harmonic tension T in [0,1]: 0.40·Diss + 0.35·Dist + 0.25·Ext (Rule 34). */
+export function chordTension(c: ParsedChord, keyPc: number): number {
+  const has7 = c.intervals.includes(10) || c.intervals.includes(11);
+  const altered9 = c.extensions.some((e) => /^(?:b|#|♭|♯)(?:9|11|13)$/.test(e));
+  const altered5 = c.extensions.some((e) => /^(?:b|#|♭|♯)5$/.test(e));
+  const tritone = hasTritone(c.pitchClasses);
+  const color6 = c.quality === '6' || c.quality === 'm6' || c.quality === '6/9' || c.quality === 'm6/9';
+  let diss = 0;
+  if (c.quality === 'dim7' || altered9) diss = 1.0;
+  else if (altered5) diss = 0.8;
+  else if (c.quality === 'augmented') diss = 0.6;
+  else if (has7 && tritone) diss = 0.6;
+  else if (has7 || color6) diss = 0.3;
+  let ext = 0;
+  if (altered9 || altered5 || c.extensions.includes('11') || c.extensions.includes('13')) ext = 0.6;
+  else if (c.intervals.includes(14) || color6) ext = 0.5;
+  else if (has7) ext = 0.3;
+  else if (c.quality === 'sus4' || c.quality === 'sus2') ext = 0.1;
+  const dist = ((((c.root - keyPc) % 12) + 12) % 12) / 12;
+  return Math.min(1, 0.4 * diss + 0.35 * dist + 0.25 * ext);
+}
+
+/* ============================ Mode vocabulary (Rules 9-20) ============================ */
+
+type Fn = 'tonic' | 'dominant' | 'domsub' | 'subdom' | 'color';
+
+interface VocabChord {
+  root: number;
+  quality: string;      // parser quality name
+  suffix: string;       // symbol suffix
+  fn: Fn;
+  deg: number;          // scale degree index (exotic planing chords: -1)
+  extClass: 0 | 1;      // 0 triad/open, 1 seventh
+  parsed: ParsedChord;
+  borrowed: boolean;
+  cadential: boolean;   // raised-leading-tone dominant used for cadences (cap-exempt)
+}
+
+const SUFFIX: Record<string, string> = {
+  major: '', minor: 'm', diminished: 'dim', augmented: '+', '7': '7', maj7: 'maj7', m7: 'm7',
+  m7b5: 'm7b5', dim7: '°7', mMaj7: 'm(maj7)', aug7: '+7', sus2: 'sus2', sus4: 'sus4', power: '5',
+  '6': '6', m6: 'm6', '7sus4': '7sus4',
+};
+
+const QUALITY_BY_IV: Record<string, string> = {
+  '0,4,7': 'major', '0,3,7': 'minor', '0,3,6': 'diminished', '0,4,8': 'augmented',
+  '0,4,7,10': '7', '0,3,7,10': 'm7', '0,3,6,10': 'm7b5', '0,4,7,11': 'maj7',
+  '0,3,7,11': 'mMaj7', '0,3,6,9': 'dim7', '0,4,8,10': 'aug7', '0,5,7,10': '7sus4',
+};
+
+const IV_BY_QUALITY: Record<string, number[]> = {
+  major: [0, 4, 7], minor: [0, 3, 7], diminished: [0, 3, 6], augmented: [0, 4, 8],
+  '7': [0, 4, 7, 10], maj7: [0, 4, 7, 11], m7: [0, 3, 7, 10], m7b5: [0, 3, 6, 10],
+  dim7: [0, 3, 6, 9], mMaj7: [0, 3, 7, 11], aug7: [0, 4, 8, 10], sus4: [0, 5, 7],
+  sus2: [0, 2, 7], power: [0, 7], '6': [0, 4, 7, 9], m6: [0, 3, 7, 9], '7sus4': [0, 5, 7, 10],
+};
+
+function mkChord(rootPc: number, quality: string, deg: number, fn: Fn, extClass: 0 | 1, borrowed: boolean, cadential = false): VocabChord | null {
+  const iv = IV_BY_QUALITY[quality];
+  if (!iv) return null;
+  const symbol = `${NOTE_NAMES[rootPc]}${SUFFIX[quality] ?? ''}`;
+  const r = parseChord(symbol);
+  if (!r.ok) return null;
+  return { root: r.chord.root, quality, suffix: SUFFIX[quality] ?? '', fn, deg, extClass, parsed: r.chord, borrowed, cadential };
+}
+
+const SEVEN_NOTE = new Set<ModeName>(['Ionian', 'Dorian', 'Phrygian', 'Lydian', 'Mixolydian', 'Aeolian', 'Locrian', 'Harmonic Minor', 'Melodic Minor']);
+
+/** Diatonic vocabulary (triads + sevenths stacked in scale thirds) for 7-note modes. */
+function buildDiatonicVocab(mode: ModeName, keyPc: number): VocabChord[] {
+  const scale = MODES[mode];
+  const out: VocabChord[] = [];
+  for (let deg = 0; deg < scale.length; deg++) {
+    const stack = (k: number) => scale[(deg + k) % scale.length] + 12 * Math.floor((deg + k) / scale.length) - scale[deg];
+    const triad = [0, stack(2), stack(4)];
+    const seventh = [...triad, stack(6)];
+    const rootPc = (keyPc + scale[deg]) % 12;
+    const triadQ = QUALITY_BY_IV[triad.join(',')];
+    const seventhQ = QUALITY_BY_IV[seventh.join(',')];
+    const fnOf = (q: string): Fn => {
+      if (deg === 0) return 'tonic';
+      if (deg === 4) return 'dominant';
+      if (deg === 3) return 'subdom';
+      if (deg === 5) return q === 'major' || q === '7' || q === 'maj7' ? 'domsub' : 'color';
+      if (deg === 6) return q === 'diminished' || q === 'm7b5' || q === 'dim7' ? 'domsub' : 'color';
+      return deg === 2 ? 'tonic' : 'color';
+    };
+    if (triadQ) { const c = mkChord(rootPc, triadQ, deg, fnOf(triadQ), 0, false); if (c) out.push(c); }
+    if (seventhQ && seventhQ !== triadQ) { const c = mkChord(rootPc, seventhQ, deg, fnOf(seventhQ), 1, false); if (c) out.push(c); }
+  }
+  return out;
+}
+
+/** Exotic strategies (Rules 18-20): WT planing, diminished 7b9/°7 on the m3 stack. */
+function buildExoticVocab(mode: ModeName, keyPc: number): VocabChord[] {
+  const out: VocabChord[] = [];
+  const root = (pc: number) => (keyPc + pc) % 12;
+  const pushSym = (r: number, symbol: string, fn: Fn, deg: number) => {
+    const p = parseChord(symbol);
+    if (p.ok) {
+      const q = p.chord.quality;
+      out.push({ root: p.chord.root, quality: q, suffix: symbol.slice(NOTE_NAMES[r].length), fn, deg, extClass: 1, parsed: p.chord, borrowed: false, cadential: false });
+    }
+  };
+  if (mode === 'Whole Tone') {
+    for (let pc = 0; pc < 12; pc += 2) {
+      const r = root(pc);
+      const isTonic = pc === 0;
+      pushSym(r, `${NOTE_NAMES[r]}+`, isTonic ? 'tonic' : 'color', isTonic ? 0 : -1);
+      pushSym(r, `${NOTE_NAMES[r]}7b5`, isTonic ? 'tonic' : 'color', isTonic ? 0 : -1);
+    }
+    return out;
+  }
+  // Diminished (Whole-Half) / (Half-Whole): dominants with b9 + dim7 on the m3 stack.
+  for (const pc of [0, 3, 6, 9]) {
+    const r = root(pc);
+    const isTonic = pc === 0;
+    pushSym(r, `${NOTE_NAMES[r]}7b9`, isTonic ? 'tonic' : 'dominant', isTonic ? 0 : -1);
+    pushSym(r, `${NOTE_NAMES[r]}°7`, isTonic ? 'tonic' : 'color', isTonic ? 0 : -1);
+  }
+  return out;
+}
+
+function buildVocab(mode: ModeName, keyPc: number): VocabChord[] {
+  return SEVEN_NOTE.has(mode) ? buildDiatonicVocab(mode, keyPc) : buildExoticVocab(mode, keyPc);
+}
+
+/** Borrowed pool (Rule 38): characteristic chords of parallel modes, not in the home vocab. */
+function buildBorrowedPool(mode: ModeName, keyPc: number, home: VocabChord[]): VocabChord[] {
+  if (!SEVEN_NOTE.has(mode)) return [];
+  const key = (c: VocabChord) => `${c.root}:${c.quality}`;
+  const have = new Set(home.map(key));
+  const seen = new Set<string>();
+  const out: VocabChord[] = [];
+  for (const m of ['Aeolian', 'Ionian', 'Phrygian', 'Dorian', 'Harmonic Minor'] as ModeName[]) {
+    if (m === mode) continue;
+    for (const c of buildDiatonicVocab(m, keyPc)) {
+      if (have.has(key(c)) || c.root === keyPc || seen.has(key(c))) continue;
+      seen.add(key(c));
+      out.push({ ...c, borrowed: true, fn: c.fn === 'dominant' ? 'color' : c.fn }); // borrowed dominants do not drive
+    }
+  }
+  return out;
+}
+
+/* ============================ Section profiles (Rules 1-8) ============================ */
+
+type ProfileKey = 'intro' | 'verse' | 'prechorus' | 'build' | 'chorus' | 'bridge' | 'breakdown' | 'outro';
+
+interface Profile {
+  density: 'sparse' | 'balanced' | 'dense' | 'tutti';
+  tension: [number, number];
+  maxExt: 0 | 1;
+  borrow: boolean;
+  entry: 'tonic' | 'free' | 'soft';
+  exit: 'dominant' | 'pacOrDeceptive' | 'free' | 'tonicFinal';
+  shape: 'flat' | 'rise' | 'plateau' | 'vshape' | 'decay';
+}
+
+const PROFILES: Record<ProfileKey, Profile> = {
+  intro:     { density: 'sparse',   tension: [0.10, 0.25], maxExt: 0, borrow: false, entry: 'tonic', exit: 'free',           shape: 'flat' },
+  verse:     { density: 'balanced', tension: [0.22, 0.42], maxExt: 1, borrow: true,  entry: 'tonic', exit: 'free',           shape: 'flat' },
+  prechorus: { density: 'dense',    tension: [0.35, 0.62], maxExt: 1, borrow: true,  entry: 'free',  exit: 'dominant',       shape: 'rise' },
+  build:     { density: 'dense',    tension: [0.35, 0.70], maxExt: 1, borrow: false, entry: 'free',  exit: 'dominant',       shape: 'rise' },
+  chorus:    { density: 'tutti',    tension: [0.45, 0.70], maxExt: 1, borrow: true,  entry: 'tonic', exit: 'pacOrDeceptive', shape: 'plateau' },
+  bridge:    { density: 'balanced', tension: [0.35, 0.62], maxExt: 1, borrow: true,  entry: 'soft',  exit: 'dominant',       shape: 'vshape' },
+  breakdown: { density: 'sparse',   tension: [0.15, 0.30], maxExt: 0, borrow: false, entry: 'tonic', exit: 'free',           shape: 'flat' },
+  outro:     { density: 'balanced', tension: [0.00, 0.40], maxExt: 1, borrow: false, entry: 'soft',  exit: 'tonicFinal',     shape: 'decay' },
+};
+
+export function resolveProfileKey(name: string): ProfileKey {
+  const n = name.trim().toLowerCase();
+  if (/intro|prelude|overture/.test(n)) return 'intro';
+  if (/pre-?chorus|rise|lift|prebuild/.test(n)) return 'prechorus';
+  if (/build/.test(n)) return 'build';
+  if (/chorus|refrain|hook|drop/.test(n)) return 'chorus';
+  if (/bridge|middle|interlude/.test(n)) return 'bridge';
+  if (/breakdown|solo|break/.test(n)) return 'breakdown';
+  if (/outro|coda|finale|fade|ending/.test(n)) return 'outro';
+  return 'verse';
+}
+
+/* ============================ Slot layout (Rules 27-28, 41-43) ============================ */
+
+interface Slot { start: number; dur: number; barIdx: number; release: boolean; role: 'normal' | 'exitDominant' | 'exitPac' | 'exitDeceptive' | 'exitTonic' }
+
+function layoutSlots(profile: Profile, bars: number, ts: TimeSignature, rng: () => number): Slot[] {
+  const barT = barTicks(ts);
+  const beatT = beatTicks(ts);
+  const compound = isCompound(ts);
+  const beats = beatOffsets(ts);
+  const slots: Slot[] = [];
+  const push = (start: number, dur: number, barIdx: number) =>
+    slots.push({ start, dur, barIdx, release: profile.shape === 'plateau' && (barIdx + 1) % 4 === 0, role: 'normal' });
+  const perBarTwo = (from: number, to: number) => {
+    for (let b = from; b < to; b++) {
+      const base = b * barT;
+      const second = compound ? beatT : (beats.length > 2 ? beats[2] : Math.floor(barT / 2));
+      push(base, second, b);
+      push(base + second, barT - second, b);
+    }
+  };
+  const perBarOne = (from: number, to: number) => { for (let b = from; b < to; b++) push(b * barT, barT, b); };
+  const everyTwo = (from: number, to: number) => { for (let b = from; b < to; b += 2) push(b * barT, Math.min(2 * barT, (to - b) * barT), b); };
+
+  if (profile.density === 'sparse') {
+    // Rule 1/7: 1 chord per 2-4 bars; 1-3 bar sections stay as single chords.
+    const span = Math.max(1, Math.min(bars, bars >= 4 ? 2 + Math.floor(rng() * 2) : bars));
+    for (let b = 0; b < bars; b += span) push(b * barT, Math.min(span * barT, (bars - b) * barT), b);
+  } else if (profile.density === 'balanced') {
+    if (bars >= 6 && rng() < 0.35) everyTwo(0, bars); else perBarOne(0, bars);
+  } else if (profile.density === 'dense') {
+    if (bars >= 4 && rng() < 0.5) { const split = Math.max(2, Math.floor(bars / 2)); everyTwo(0, split); perBarOne(split, bars); }
+    else if (rng() < 0.5) perBarTwo(0, bars);
+    else perBarOne(0, bars);
+  } else { // tutti (Rule 41) — compound capped at 2/bar (Rule 28)
+    if (!compound && bars >= 4 && rng() < 0.3) perBarTwo(0, bars);
+    else if (bars >= 8 && rng() < 0.4) { const half = Math.max(2, Math.floor(bars / 2)); perBarOne(0, half); perBarTwo(half, bars); }
+    else perBarTwo(0, bars);
+  }
+
+  if (profile.shape === 'rise' && bars >= 3) {
+    // Build ramp (Rule 42): first half 1 chord/2 bars, then 1/bar, final quarter 2/bar.
+    slots.length = 0;
+    const half = Math.max(2, Math.floor(bars / 2)), thirdQ = Math.max(2, Math.floor(bars * 0.75));
+    everyTwo(0, half);
+    perBarOne(half, thirdQ);
+    perBarTwo(thirdQ, bars);
+    slots.sort((a, b) => a.start - b.start);
+    for (let i = 1; i < slots.length; i++) if (slots[i].start < slots[i - 1].start + slots[i - 1].dur) { slots.splice(i, 1); i--; }
+  }
+
+  // Exit marking (cadences are Tier 1, Rules 29-33)
+  if (slots.length) {
+    const last = slots[slots.length - 1];
+    if (profile.exit === 'dominant') last.role = 'exitDominant';
+    else if (profile.exit === 'pacOrDeceptive') {
+      const deceptive = rng() < 0.4 && slots.length >= 2;
+      if (deceptive) { slots[slots.length - 2].role = 'exitDominant'; last.role = 'exitDeceptive'; }
+      else if (slots.length >= 2) { slots[slots.length - 2].role = 'exitDominant'; last.role = 'exitPac'; }
+      else last.role = 'exitPac';
+    } else if (profile.exit === 'tonicFinal') last.role = 'exitTonic';
+  }
+  return slots;
+}
+
+/* ============================ Walk + score ============================ */
+
+interface Emitted { slot: Slot; chord: VocabChord; symbol: string; tension: number; cadBorrow: boolean }
+interface SectionResult { chords: Emitted[]; violations: number; strongRatio: number }
+
+const STRONG = new Set([5, 7, 1, 2, 8, 9]);   // down-5th, up-2nd, down-3rd (Rule 21)
+const WEAK = new Set([3, 4, 10, 11]);          // ascending 3rd, descending 2nd (Rule 22)
+
+const rootDiff = (a: number, b: number) => (((b - a) % 12) + 12) % 12;
+const sharedPcs = (a: ParsedChord, b: ParsedChord) => {
+  const sb = new Set(b.pitchClasses);
+  return a.pitchClasses.filter((p) => sb.has(p)).length;
+};
+const isDominantFamily = (c: VocabChord) =>
+  (c.fn === 'dominant' || c.fn === 'domsub') && (c.quality === 'major' || c.quality === '7' || c.quality === 'maj7');
+
+function targetTensionAt(profile: Profile, pos: number): number {
+  const [lo, hi] = profile.tension;
+  switch (profile.shape) {
+    case 'flat': return (lo + hi) / 2;
+    case 'rise': return lo + (hi - lo) * pos;
+    case 'plateau': return (lo + hi) / 2;
+    case 'vshape': return pos < 0.5 ? lo + 0.08 * (pos / 0.5) : lo + 0.08 + (hi - lo - 0.08) * ((pos - 0.5) / 0.5);
+    case 'decay': return hi + (lo - hi) * pos;
+  }
+}
+
+function dominantCandidates(vocab: VocabChord[], tonicPc: number, mode: ModeName): VocabChord[] {
+  const pool = vocab.filter(isDominantFamily);
+  if (SEVEN_NOTE.has(mode)) {
+    const upgraded = mkChord((tonicPc + 7) % 12, '7', 4, 'dominant', 1, false, true);
+    if (upgraded && !pool.some((c) => c.root === upgraded.root && c.quality === upgraded.quality)) pool.push(upgraded);
+  }
+  return pool;
+}
+
+function walkSection(
+  section: Section, profile: Profile, slots: Slot[], vocab: VocabChord[], borrowedPool: VocabChord[],
+  mode: ModeName, keyPc: number, ts: TimeSignature, rng: () => number, needDominantExit: boolean,
+): SectionResult {
+  const barT = barTicks(ts);
+  const span = Math.max(1, section.lengthBars * barT);
+  const cap = Math.max(1, Math.round(section.lengthBars / 4)); // Rule 38: <=2 per 8 bars ~ 1 per 4
+  const exotic = !SEVEN_NOTE.has(mode);
+  const domPool = profile.exit === 'dominant' || profile.exit === 'pacOrDeceptive' ? dominantCandidates(vocab, keyPc, mode) : [];
+  const emitted: Emitted[] = [];
+  let violations = 0;
+  let strong = 0, transitions = 0;
+  let borrowCount = 0;
+  let borrowBonusGiven = false;
+
+  const openPool = [
+    mkChord(keyPc, 'power', 0, 'tonic', 0, false),
+    mkChord(keyPc, 'sus4', 0, 'tonic', 0, false),
+    mkChord((keyPc + 10) % 12, 'power', 5, 'domsub', 0, false),
+    mkChord(keyPc, 'minor', 0, 'tonic', 0, false),
+    mkChord(keyPc, 'major', 0, 'tonic', 0, false),
+  ].filter((c): c is VocabChord => c !== null);
+
+  for (let si = 0; si < slots.length; si++) {
+    const slot = slots[si];
+    const isRelease = slot.release && slot.role === 'normal'; // exits override releases (avoids empty slot conflicts)
+    const posInSection = Math.max(0, Math.min(1, slot.start / span));
+    let target = targetTensionAt(profile, posInSection);
+    if (isRelease) target = 0.35; // Rule 36 release bars
+    if (slot.role === 'exitDominant' || slot.role === 'exitPac' || slot.role === 'exitDeceptive') target = Math.max(target, 0.6);
+    if (slot.role === 'exitTonic') target = 0;
+
+    const prev = emitted[emitted.length - 1];
+    let pool: VocabChord[];
+    if (profile.density === 'sparse' && profile.maxExt === 0) {
+      pool = section.lengthBars <= 4 || si % 3 !== 2
+        ? openPool
+        : vocab.filter((c) => c.extClass === 0 && (c.fn === 'tonic' || c.fn === 'subdom' || c.fn === 'domsub'));
+    } else {
+      pool = vocab.filter((c) => c.extClass <= profile.maxExt);
+    }
+
+    // Borrowing (Rules 38-40): not on bar 1, capped, must resolve to diatonic next slot.
+    const canBorrow = profile.borrow && !exotic && slot.barIdx >= 1 && borrowCount < cap && si < slots.length - 1;
+    if (canBorrow) for (const bc of borrowedPool) if (bc.extClass <= profile.maxExt) pool.push(bc);
+    if (slot.role === 'exitDominant' || slot.role === 'exitPac' || slot.role === 'exitDeceptive') pool.push(...domPool.filter((c) => c.extClass <= Math.max(1, profile.maxExt)));
+
+    const eligible = pool.filter((c) => {
+      if (prev) {
+        const dm = rootDiff(prev.chord.root, c.root);
+        if (dm === 0 && prev.chord.quality === c.quality) {
+          const heldBars = (slot.start + slot.dur - emitted[0].slot.start) / barT; // same-symbol run length
+          if (heldBars > 2 && profile.density !== 'sparse') return false; // Rule 23
+        }
+        if (dm === 6) {
+          // Rules 24/26: tritone only as functional resolution from a tritone-containing dominant.
+          if (!(hasTritone(prev.chord.parsed.pitchClasses) && (c.fn === 'tonic' || c.fn === 'dominant'))) return false;
+        }
+        if (!exotic) {
+          const ct = sharedPcs(prev.chord.parsed, c.parsed);
+          if ((dm === 5 || dm === 7) && ct < 1) return false; // Rule 25
+          if ((dm === 3 || dm === 4 || dm === 8 || dm === 9) && ct < 2) return false;
+        }
+        if (prev.chord.borrowed && c.borrowed) return false; // Rule 40: borrowed resolves next slot
+      } else {
+        // Entry slot: structural, not just tension-optimal — tonic-rooted; dim sonorities
+        // only when they ARE the mode's tonic (Locrian, Rule 15).
+        if (profile.entry === 'tonic' && slot.role === 'normal' && profile.density !== 'sparse') {
+          if (c.root !== keyPc || (['diminished', 'm7b5', 'dim7'].includes(c.quality) && c.deg !== 0)) return false;
+        }
+        if (profile.entry === 'soft' && slot.role === 'normal' && !(c.fn === 'subdom' || c.fn === 'tonic' || c.fn === 'color')) return false;
+      }
+      if (slot.role === 'exitDominant' && !isDominantFamily(c)) return false;
+      // PAC lands on the tonic sonority (Locrian's is dim — Rule 15 stabilization).
+      if (slot.role === 'exitPac' && !(c.root === keyPc && (c.quality === 'minor' || c.quality === 'major' || (c.deg === 0 && (c.quality === 'diminished' || c.quality === 'm7b5'))))) return false;
+      if (slot.role === 'exitDeceptive' && !(c.root === (keyPc + 8) % 12 && c.quality === 'major')) return false;
+      if (slot.role === 'exitTonic' && !(c.root === keyPc && ['minor', 'major', 'power', 'sus4'].includes(c.quality))) return false;
+      if (isRelease && !(c.fn === 'tonic' || c.fn === 'subdom')) return false;
+      if (c.borrowed && !c.cadential && slot.barIdx === 0) return false; // Rule 39
+      return true;
+    });
+    if (!eligible.length) continue;
+
+    const scored = eligible.map((c) => {
+      const t = chordTension(c.parsed, keyPc);
+      let s = -Math.abs(t - target) * 1.4;
+      if (prev) {
+        const dm = rootDiff(prev.chord.root, c.root);
+        if (STRONG.has(dm)) s += 0.12;
+        else if (WEAK.has(dm)) s -= 0.08;
+        if (dm === 0 && prev.chord.quality === c.quality) s -= 0.05;
+        if (c.fn === prev.chord.fn && c.fn !== 'color') s -= 0.08;
+        if (prev.chord.borrowed && !c.borrowed) s += 0.15; // resolution bonus (Rule 40)
+      } else if (profile.entry === 'soft' && (c.fn === 'subdom' || c.fn === 'color')) s += 0.1;
+      if (slot.role === 'exitDominant' && c.quality === '7') s += 0.08;
+      if (c.borrowed) s += profile.shape === 'vshape' && !borrowBonusGiven ? 0.35 : 0.12;
+      s += rng() * 0.06; // seeded tiebreak noise (Rule 45: content varies, grid does not)
+      return { c, s, t };
+    }).sort((a, b) => b.s - a.s);
+
+    const best = scored[0].s;
+    const band = scored.filter((x) => best - x.s <= 0.15); // Rule 44 tie band
+    const pick = band[Math.floor(rng() * band.length)];
+    if (pick.c.borrowed) { borrowCount++; borrowBonusGiven = true; }
+    emitted.push({ slot, chord: pick.c, symbol: pick.c.parsed.symbol, tension: pick.t, cadBorrow: pick.c.cadential });
+    if (prev) {
+      const dm = rootDiff(prev.chord.root, pick.c.root);
+      if (STRONG.has(dm)) { strong++; transitions++; }
+      else if (dm !== 0) transitions++;
+    }
+  }
+
+  // Violations (soft rules, Rule 44 tiers 3-4)
+  const barTension: { bar: number; t: number }[] = [];
+  for (const e of emitted) {
+    const cur = barTension.find((x) => x.bar === e.slot.barIdx);
+    if (cur) cur.t = e.tension; else barTension.push({ bar: e.slot.barIdx, t: e.tension });
+  }
+  barTension.sort((a, b) => a.bar - b.bar);
+  if (profile.shape === 'rise') for (let i = 1; i < barTension.length; i++) if (barTension[i].t < barTension[i - 1].t - 1e-9) violations += 1;
+  if (profile.shape === 'decay') for (let i = 1; i < barTension.length; i++) if (barTension[i].t > barTension[i - 1].t + 0.02) violations += 1;
+  if (profile.shape === 'plateau' && barTension.length) {
+    if (!barTension.some((x) => x.t >= 0.42)) violations += 1; // no dominant-tension peak
+    if (!barTension.some((x) => x.t <= 0.4)) violations += 0.5; // no release (Rule 36)
+  }
+  if (profile.shape === 'vshape' && barTension.length) {
+    if (barTension[0].t > 0.5) violations += 0.5;
+    if (barTension[barTension.length - 1].t < 0.58) violations += 0.5;
+  }
+  const ratio = transitions ? strong / transitions : 1;
+  if (transitions >= 3 && ratio < 0.6 && profile.shape !== 'flat') violations += 1; // Rule 21
+  if (profile.borrow && profile.shape === 'vshape' && borrowCount === 0 && section.lengthBars >= 4) violations += 0.5; // Rule 6
+  if (needDominantExit && profile.exit === 'free' && emitted.length) {
+    const last = emitted[emitted.length - 1];
+    if (!isDominantFamily(last.chord)) violations += 0.25; // softened per red-team fix #5
+  }
+  return { chords: emitted, violations, strongRatio: ratio };
+}
+
+/* ============================ Emission ============================ */
+
+function emitSymbols(section: Section, emitted: Emitted[], ts: TimeSignature, rng: () => number): Chord[] {
+  const barT = barTicks(ts);
+  const out: Chord[] = [];
+  let runStart: number | null = null;
+  let runKey = '';
+  for (const e of emitted) {
+    const key = `${e.chord.root}:${e.chord.quality}`;
+    const heldBars = runStart === null ? 0 : (e.slot.start + e.slot.dur - runStart) / barT;
+    let symbol = e.chord.parsed.symbol;
+    if (key === runKey && heldBars > 2 && !['power', 'sus4', 'sus2'].includes(e.chord.quality)) {
+      // Rule 23 relief: shift inversion (slash third or fifth) instead of repeating.
+      const ivs = e.chord.parsed.intervals;
+      const third = ivs.find((x) => x === 3 || x === 4);
+      const fifth = ivs.includes(7) ? 7 : third;
+      const bassIv = third !== undefined && rng() < 0.5 ? third : (fifth ?? 7);
+      const candidate = `${NOTE_NAMES[e.chord.root]}${e.chord.suffix}/${NOTE_NAMES[(e.chord.root + bassIv) % 12]}`;
+      if (parseChord(candidate).ok && candidate !== symbol) { symbol = candidate; runStart = e.slot.start; }
+      else { runStart = e.slot.start; }
+    } else if (key !== runKey) runStart = e.slot.start;
+    runKey = key;
+    out.push({
+      id: uid('chd'),
+      symbol,
+      startTick: Math.round((section.startBar - 1) * barT + e.slot.start),
+      durationTicks: Math.max(1, Math.round(e.slot.dur)),
+    });
+  }
+  return out;
+}
+
+/* ============================ Main entry ============================ */
+
+export function generateProgression(project: Project, options: ProgressionOptions): Chord[] {
+  const mode = options.mode ?? 'all';
+  const seed = Math.round(options.seed);
+  const ts = project.timeSignature;
+  const barT = barTicks(ts);
+
+  const sections: Section[] = project.sections.length
+    ? [...project.sections].sort((a, b) => a.startBar - b.startBar)
+    : [{ id: '__all', name: 'Verse', startBar: 1, lengthBars: projectBarsFallback(project, barT) }];
+
+  const covered: [number, number][] = mode === 'empty'
+    ? project.chords.map((c) => [c.startTick, c.startTick + c.durationTicks] as [number, number]).sort((a, b) => a[0] - b[0])
+    : [];
+
+  const out: Chord[] = [];
+  if (mode === 'empty') out.push(...project.chords);
+
+  for (let idx = 0; idx < sections.length; idx++) {
+    const section = sections[idx];
+    const profileKey = resolveProfileKey(section.name);
+    const profile = PROFILES[profileKey];
+    const next = sections[idx + 1];
+    const nextIsChorus = next ? resolveProfileKey(next.name) === 'chorus' : false;
+    const prevBefore = sections[idx - 1];
+    // Red-team fix #5: only the section directly before the Chorus MUST exit dominant.
+    const needDominantExit =
+      profileKey === 'prechorus' || profileKey === 'build' ||
+      (profileKey === 'verse' && nextIsChorus &&
+        (!prevBefore || ['verse', 'intro', 'bridge', 'breakdown'].includes(resolveProfileKey(prevBefore.name))));
+    const effectiveProfile: Profile =
+      profileKey === 'verse' && needDominantExit ? { ...profile, exit: 'dominant' } : profile;
+
+    const baseSeed = hashString(`chordgen|${seed}|${project.key}|${project.mode}|${ts.numerator}/${ts.denominator}|${section.id}|${section.startBar}|${section.lengthBars}`);
+    const vocab = buildVocab(project.mode as ModeName, project.key);
+    const borrowedPool = buildBorrowedPool(project.mode as ModeName, project.key, vocab);
+    let best: SectionResult | null = null;
+
+    for (let attempt = 0; attempt < 56; attempt++) {
+      const rng = mulberry32((baseSeed ^ hashString(`layout${attempt}`)) >>> 0);
+      let slots = layoutSlots(effectiveProfile, section.lengthBars, ts, rng);
+      if (!slots.length) continue;
+      if (mode === 'empty') {
+        slots = slots
+          .map((s) => {
+            let a = s.start, b = s.start + s.dur;
+            for (const [cs, ce] of covered) if (a < ce && b > cs && a >= cs) a = Math.max(a, ce);
+            for (const [cs, ce] of covered) if (a < ce && b > cs && b <= ce) b = Math.min(b, cs);
+            for (const [cs, ce] of covered) if (a < ce && b > cs && a < cs && b > ce) return null; // fully covered
+            return b - a >= beatTicks(ts) * 0.5 ? { ...s, start: a, dur: b - a } : null;
+          })
+          .filter((s): s is Slot => s !== null);
+        if (!slots.length) { best = { chords: [], violations: -1, strongRatio: 1 }; break; }
+      }
+      const rng2 = mulberry32((baseSeed ^ hashString(`walk${attempt}`)) >>> 0);
+      const res = walkSection(section, effectiveProfile, slots, vocab, borrowedPool, project.mode as ModeName, project.key, ts, rng2, needDominantExit);
+      if (!best || res.violations < best.violations) best = res;
+      if (best.violations === 0) break;
+    }
+
+    if (best) {
+      const rngEmit = mulberry32((baseSeed ^ hashString('emit')) >>> 0);
+      out.push(...emitSymbols(section, best.chords, ts, rngEmit));
+    }
+  }
+
+  const safe = out.filter((c) => parseChord(c.symbol).ok);
+  safe.sort((a, b) => a.startTick - b.startTick || a.durationTicks - b.durationTicks);
+  return safe;
+}
+
+function projectBarsFallback(project: Project, barT: number): number {
+  let bars = 0;
+  for (const c of project.chords) bars = Math.max(bars, Math.ceil((c.startTick + c.durationTicks) / barT));
+  return bars || 8;
+}
