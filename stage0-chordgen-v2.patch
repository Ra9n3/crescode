+import { describe, expect, it } from 'vitest';
+import { parseChord, type ParsedChord } from '../src/shared/schema/chords';
+import { barTicks, beatOffsets, beatTicks, isCompound } from '../src/shared/schema/meter';
+import { MODES } from '../src/shared/schema/modes';
+import { chordTension, generateProgression, resolveProfileKey } from '../src/orchestrator/chordgen';
+import type { Chord, Project, Section } from '../src/shared/schema/types';
+
+const P = (s: string): ParsedChord => {
+  const r = parseChord(s);
+  if (!r.ok) throw new Error(`test helper: ${s} does not parse`);
+  return r.chord;
+};
+
+/* ---------- helpers ---------- */
+
+let idc = 0;
+const sec = (name: string, startBar: number, lengthBars: number): Section =>
+  ({ id: `s${idc++}`, name, startBar, lengthBars });
+
+function makeProject(sections: Section[], opts: { key?: number; mode?: Project['mode']; ts?: Project['timeSignature']; chords?: Chord[] } = {}): Project {
+  const timeSignature = opts.ts ?? { numerator: 4, denominator: 4 };
+  return {
+    schemaVersion: 1,
+    name: 'test',
+    bpm: 100,
+    tempoMap: [{ tick: 0, bpm: 100 }],
+    timeSignature,
+    key: opts.key ?? 2, // D
+    mode: opts.mode ?? 'Dorian',
+    sections,
+    chords: opts.chords ?? [],
+    referenceAudio: { path: null, offsetMs: 0 },
+    tracks: [],
+    libraryGroups: [],
+    masterVolume: 1,
+  };
+}
+
+const barT = (p: Project) => barTicks(p.timeSignature);
+const spanOf = (p: Project, s: Section) => ({ start: (s.startBar - 1) * barT(p), end: (s.startBar - 1) * barT(p) + s.lengthBars * barT(p) });
+
+function chordsIn(p: Project, s: Section): Chord[] {
+  const { start, end } = spanOf(p, s);
+  return p.chords.filter((c) => c.startTick >= start && c.startTick < end).sort((a, b) => a.startTick - b.startTick);
