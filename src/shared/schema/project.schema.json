{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crescode://project.schema.json",
  "title": "Crescode Project",
  "description": "Crescode project document. All times are ticks at 960 PPQ.",
  "type": "object",
  "required": ["schemaVersion", "name", "bpm", "tempoMap", "timeSignature", "key", "mode", "sections", "chords", "referenceAudio", "tracks", "libraryGroups", "masterVolume"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "name": { "type": "string" },
    "bpm": { "type": "number", "minimum": 20, "maximum": 400 },
    "tempoMap": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": { "type": "object", "required": ["tick", "bpm"], "properties": { "tick": { "type": "integer", "const": 0 }, "bpm": { "type": "number" } } }
    },
    "timeSignature": {
      "type": "object", "required": ["numerator", "denominator"],
      "properties": { "numerator": { "type": "integer", "minimum": 1, "maximum": 32 }, "denominator": { "enum": [1, 2, 4, 8, 16, 32] } }
    },
    "key": { "type": "integer", "minimum": 0, "maximum": 11 },
    "mode": { "enum": ["Ionian", "Dorian", "Phrygian", "Lydian", "Mixolydian", "Aeolian", "Locrian", "Harmonic Minor", "Melodic Minor", "Whole Tone", "Diminished (Half-Whole)", "Diminished (Whole-Half)"] },
    "sections": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "name", "startBar", "lengthBars"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "startBar": { "type": "integer", "minimum": 1 }, "lengthBars": { "type": "integer", "minimum": 1 } } }
    },
    "chords": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "symbol", "startTick", "durationTicks"], "properties": { "id": { "type": "string" }, "symbol": { "type": "string" }, "startTick": { "type": "integer", "minimum": 0 }, "durationTicks": { "type": "integer", "minimum": 1 } } }
    },
    "referenceAudio": {
      "type": "object", "required": ["path", "offsetMs"],
      "properties": { "path": { "type": ["string", "null"] }, "offsetMs": { "type": "number" } }
    },
    "tracks": { "type": "array", "items": { "$ref": "#/$defs/track" } },
    "ensemble": { "$ref": "#/$defs/ensemble" },
    "orchestration": { "$ref": "#/$defs/orchestration" },
    "libraryGroups": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "name", "pluginId", "pluginState"], "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "pluginId": { "type": ["string", "null"] }, "pluginState": { "type": ["string", "null"], "contentEncoding": "base64" } } }
    },
    "masterVolume": { "type": "number", "minimum": 0, "maximum": 1.5 }
  },
  "$defs": {
    "ensemble": {
      "type": "object",
      "description": "Band memory: which ensemble template is on, per-composition in/out overrides from the track-header buttons (cleared on template switch), and sticky project-settings pins (always in / always out). A band marks membership over existing instrument tracks — it never creates or deletes them. Absent field = no band: every instrument track is in. Precedence: pins beat overrides, overrides beat the template roster.",
      "properties": {
        "templateId": { "type": ["string", "null"], "description": "Shipped ensemble template id (e.g. \"ensemble.symphony\"), or null for no band." },
        "overrides": { "$ref": "#/$defs/bandStates" },
        "pins": { "$ref": "#/$defs/bandStates" }
      }
    },
    "bandStates": {
      "type": "object",
      "description": "Instrument role -> \"in\" | \"out\". Keys must be real instrument track roles (Strings/Brass/Woodwinds/Percussion/Keys), never Structure or Audio lanes.",
      "additionalProperties": { "enum": ["in", "out"] }
    },
    "note": {
      "type": "object", "required": ["pitch", "startTick", "durationTicks", "velocity"],
      "properties": {
        "pitch": { "type": "integer", "minimum": 0, "maximum": 127 }, "startTick": { "type": "integer", "minimum": 0 }, "durationTicks": { "type": "integer", "minimum": 1 }, "velocity": { "type": "integer", "minimum": 1, "maximum": 127 },
        "articulation": { "enum": ["legato", "detache", "marcato", "staccato", "spiccato", "pizz", "tremolo", "portato", "sulTasto", "sulPont", "conSord"] },
        "roleTag": { "enum": ["anchor", "lift", "settle", "bed", "atmosphere"], "description": "Planner-assigned piano role: held anchor, rising lift, falling settle, bed figure, or cascade atmosphere." },
        "bow": { "enum": ["down", "up"] },
        "layer": { "enum": ["cb", "div2", "kbd"], "description": "The Vc+Cb layering marks its Cb-doubled notes ('cb'); a divisi moment marks its second line ('div2'); legacy piano comping voices may be marked 'kbd'. Export profiles split the cellosBasses track by 'cb'; 'div2' and 'kbd' notes export with their parent part." }
      }
    },
    "orchestration": {
      "type": "object",
      "description": "Orchestration memory: which take the current score is, per-section take counters (re-roll one section only) and sections locked through Compose All. Absent field = no orchestration yet.",
      "required": ["take"],
      "properties": {
        "take": { "type": "integer", "minimum": 0 },
        "sectionTakes": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "sectionLocks": { "type": "array", "items": { "type": "string" } }
      }
    },
    "track": {
      "type": "object",
      "required": ["id", "name", "family", "color", "role", "lowestNote", "highestNote", "locked", "muted", "soloed", "libraryGroupId", "midiChannel", "frozen", "volume", "pan", "notes"],
      "properties": {
        "id": { "type": "string" }, "name": { "type": "string" },
        "family": { "enum": ["Structure", "Audio", "Strings", "Brass", "Woodwinds", "Percussion", "Keys"] },
        "color": { "type": "string" }, "role": { "type": "string" },
        "lowestNote": { "type": "integer", "minimum": 0, "maximum": 127 },
        "highestNote": { "type": "integer", "minimum": 0, "maximum": 127 },
        "locked": { "type": "boolean" }, "muted": { "type": "boolean" }, "soloed": { "type": "boolean" },
        "libraryGroupId": { "type": ["string", "null"] },
        "midiChannel": { "type": "integer", "minimum": 1, "maximum": 16 },
        "frozen": { "type": "boolean" },
        "volume": { "type": "number", "minimum": 0, "maximum": 1.5 },
        "pan": { "type": "number", "minimum": -1, "maximum": 1 },
        "notes": { "type": "array", "items": { "$ref": "#/$defs/note" } },
        "cc": {
          "type": "array",
          "description": "Optional CC automation lanes. One lane per controller number; points sorted by tick within [0, project end].",
          "items": {
            "type": "object", "required": ["cc", "points"],
            "properties": {
              "cc": { "type": "integer", "minimum": 0, "maximum": 127 },
              "points": {
                "type": "array", "maxItems": 1024,
                "items": { "type": "object", "required": ["tick", "value"], "properties": { "tick": { "type": "integer", "minimum": 0 }, "value": { "type": "integer", "minimum": 0, "maximum": 127 } } }
              }
            }
          }
        }
      }
    }
  }
}
