+    expect(T('G7')).toBeLessThan(T('A7b9'));
+    expect(T('Dm')).toBeLessThan(T('Bbmaj7'));
+  });
+});
+
+/* ---------- core generation ---------- */
+
+describe('progression generator — invariants', () => {
+  it('determinism: same seed -> identical chords; different seed -> different content (Rule 45)', () => {
+    const p = makeProject(STANDARD);
