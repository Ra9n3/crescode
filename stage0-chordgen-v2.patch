+  it('exit cadences: dominant exit before Chorus, PAC/deceptive at Chorus end (Rules 3/29/33)', () => {
+    const p = makeProject([sec('Verse', 1, 8), sec('Pre-Chorus', 9, 4), sec('Chorus', 13, 8)]);
+    p.chords = generateProgression(p, { seed: 21 });
+    const D = p.key;
+    const degree4Root = (D + MODES.Dorian[4]) % 12;
+    const pre = chordsIn(p, p.sections[1]);
+    const preLast = P(pre[pre.length - 1].symbol);
+    // dominant family: root on degree 5 (A) or subtonic (C) with major/7 quality
+    const okRoots = [degree4Root, (D + MODES.Dorian[6]) % 12];
+    expect(okRoots, `pre-chorus exits on ${preLast.symbol}`).toContain(preLast.root);
