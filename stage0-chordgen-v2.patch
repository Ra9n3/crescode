+      }
+      expect(t).toBe(end);
+    }
+  });
+
+  it('compound meter: chord changes only on felt beats (Rule 28)', () => {
+    const ts = { numerator: 6, denominator: 8 };
+    const p = makeProject(STANDARD, { ts });
+    p.chords = generateProgression(p, { seed: 5 });
+    const offsets = new Set(beatOffsets(ts).map((o) => Math.round(o)));
