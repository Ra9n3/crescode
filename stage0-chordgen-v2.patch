+  });
+
+  it('every emitted symbol parses (engine invariant)', () => {
+    const p = makeProject([sec('Intro', 1, 4), ...STANDARD, sec('Bridge', 17, 4), sec('Outro', 21, 4)]);
+    const out = generateProgression(p, { seed: 11 });
+    expect(out.length).toBeGreaterThan(4);
+    for (const c of out) {
+      const r = parseChord(c.symbol);
+      expect(r.ok, `${c.symbol}: ${r.ok ? '' : r.error}`).toBe(true);
+    }
+  });
+
+  it('chords tile each section exactly: contiguous, aligned, no gaps/overlaps (Rules 27/28/43)', () => {
+    const p = makeProject(STANDARD);
+    p.chords = generateProgression(p, { seed: 3 });
+    const bt = beatTicks(p.timeSignature);
