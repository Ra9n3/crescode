+  });
+
+  it('outro decays to a root-position tonic triad (Rule 8)', () => {
+    const p = makeProject([sec('Verse', 1, 8), sec('Outro', 9, 4)]);
+    p.chords = generateProgression(p, { seed: 2 });
+    const out = chordsIn(p, p.sections[1]);
+    const last = P(out[out.length - 1].symbol);
+    expect(last.root).toBe(p.key);
+    expect(['minor', 'major', 'power', 'sus4']).toContain(last.quality);
+  });
+
+  it('build tension rises monotonically bar over bar (Rule 35)', () => {
+    const p = makeProject([sec('Verse', 1, 8), sec('Build', 9, 4), sec('Chorus', 13, 8)]);
+    p.chords = generateProgression(p, { seed: 31 });
+    const D = p.key;
+    const build = chordsIn(p, p.sections[1]);
+    const perBar: { bar: number; t: number }[] = [];
+    for (const c of build) {
+      const bar = Math.floor(c.startTick / barT(p));
+      const t = chordTension(P(c.symbol), D);
+      const cur = perBar.find((x) => x.bar === bar);
+      if (cur) cur.t = t; else perBar.push({ bar, t });
