@@ -0,0 +1,951 @@
+/**
+ * ============================================================================
+ *  CRESCODE STAGE 0 — CHORD PROGRESSION GENERATOR ("Generate Progression")
+ * ============================================================================
+ * Flexible structure-driven generation (spec agreed with the user, 2026-10-28):
+ *
+ *  - The ARRANGER owns sections. The dialog shows them read-only; Generate
+ *    never edits sections. Section type + position set the harmonic pace,
+ *    section length sets the phrasing (4-bar phrases + one shorter remainder).
+ *  - Chord lengths are GENERATED, never from a fixed count. Minimum length is
+ *    half a bar rounded to whole beats; chords start on felt beats.
+ *  - Hard rules (built into generation, never checked afterwards):
+ *      1. every chord is diatonic, a free functional chord (V / vii°) or a
+ *         whitelisted borrowed chord (mid-phrase only, capped);
+ *      2. every phrase ends with a cadence suited to its position
+ *         (open mid-song, resolved at section ends, tonic at song end);
+ *      3. first chord of the song is tonic, last is tonic (only when the
+ *         scope touches the song start/end);
+ *      4. no chord repeats directly after itself (same root+quality —
+ *         C -> C/E still counts);
+ *      5. chords fill the scope exactly: no gaps, no overlaps;
+ *      6. same-type sections share a harmonic shape (with variation).
+ *  - Determinism: same seed + same structure => identical output. Each section
+ *    has a sub-seed from (seed, section id); re-rolling one section never
+ *    touches the others. N = 24 candidates per section, scored; best wins.
+ *    Below the floor => safe built-in fallback (counted and reported).
+ *  - Walls: locked chords ("Whole song"/"Selected section"), every existing
+ *    chord ("Empty areas only"), and both neighbouring chords at section
+ *    boundaries. Generation fills only what is not walled.
+ *
+ * Engineering invariants (unchanged): deterministic from (seed, project),
+ * no Math.random, every emitted symbol passes parseChord, no new deps.
+ */
+import { parseChord, type ParsedChord } from '../shared/schema/chords';
+import { beatTicks, barTicks } from '../shared/schema/meter';
+import { MODES, NOTE_NAMES } from '../shared/schema/modes';
+import { hashString, mulberry32 } from '../engine/generate';
+import { uid } from '../shared/schema/factory';
+import type { Chord, ModeName, Project, Section } from '../shared/schema/types';
+
+export type GenScope = 'empty' | 'all' | 'section';
+
+export interface ProgressionOptions {
+  seed: number;
+  /** 'empty' (default) fills gaps around every existing chord; 'all' replaces unlocked chords; 'section' only the given section. */
+  scope?: GenScope;
+  /** Section id for scope 'section'. */
+  sectionId?: string;
+  /** Re-roll mode: regenerate only this section with a fresh sub-seed (its shape diverges from siblings). */
+  rerollSectionId?: string;
+}
+
+export interface SectionReport {
+  sectionId: string;
+  name: string;
+  chordCount: number;
+  score: number;
+  fallback: boolean;
+}
+
+export interface ProgressionResult {
+  chords: Chord[];
+  reports: SectionReport[];
+  fallbackCount: number;
+}
+
+/** Provisional quality floor — to be calibrated by ear from the seed-audit dump (user decision #9). */
+export const SCORE_FLOOR = 0.62;
+const CANDIDATES_PER_SECTION = 24;
+
+/* ============================ Tension metric ============================ */
+
+function hasTritone(pcs: number[]): boolean {
+  for (let i = 0; i < pcs.length; i++) for (let j = i + 1; j < pcs.length; j++) if ((pcs[i] - pcs[j] + 12) % 12 === 6) return true;
+  return false;
+}
+
+/** Harmonic tension T in [0,1]: 0.40·Diss + 0.35·Dist + 0.25·Ext. */
+export function chordTension(c: ParsedChord, keyPc: number): number {
+  const has7 = c.intervals.includes(10) || c.intervals.includes(11);
+  const altered9 = c.extensions.some((e) => /^(?:b|#|♭|♯)(?:9|11|13)$/.test(e));
+  const altered5 = c.extensions.some((e) => /^(?:b|#|♭|♯)5$/.test(e));
+  const tritone = hasTritone(c.pitchClasses);
+  const color6 = c.quality === '6' || c.quality === 'm6' || c.quality === '6/9' || c.quality === 'm6/9';
+  let diss = 0;
+  if (c.quality === 'dim7' || altered9) diss = 1.0;
+  else if (altered5) diss = 0.8;
+  else if (c.quality === 'augmented') diss = 0.6;
+  else if (has7 && tritone) diss = 0.6;
+  else if (has7 || color6) diss = 0.3;
+  let ext = 0;
+  if (altered9 || altered5 || c.extensions.includes('11') || c.extensions.includes('13')) ext = 0.6;
+  else if (c.intervals.includes(14) || color6) ext = 0.5;
+  else if (has7) ext = 0.3;
+  else if (c.quality === 'sus4' || c.quality === 'sus2') ext = 0.1;
+  const dist = ((((c.root - keyPc) % 12) + 12) % 12) / 12;
+  return Math.min(1, 0.4 * diss + 0.35 * dist + 0.25 * ext);
+}
+
+/* ============================ Mode vocabulary ============================ */
+
+type Fn = 'tonic' | 'dominant' | 'domsub' | 'subdom' | 'color';
+
+interface VocabChord {
+  root: number;
+  quality: string;
+  suffix: string;
+  fn: Fn;
+  deg: number;          // scale degree index (exotic planing chords: -1)
+  extClass: 0 | 1;
+  parsed: ParsedChord;
+  borrowed: boolean;
+  cadential: boolean;   // free functional chord (V / vii°) — cap-exempt, never "borrowed"
+}
+
+const SUFFIX: Record<string, string> = {
+  major: '', minor: 'm', diminished: 'dim', augmented: '+', '7': '7', maj7: 'maj7', m7: 'm7',
+  m7b5: 'm7b5', dim7: '°7', mMaj7: 'm(maj7)', aug7: '+7', sus2: 'sus2', sus4: 'sus4', power: '5',
+  '6': '6', m6: 'm6', '7sus4': '7sus4',
+};
+
+const QUALITY_BY_IV: Record<string, string> = {
+  '0,4,7': 'major', '0,3,7': 'minor', '0,3,6': 'diminished', '0,4,8': 'augmented',
+  '0,4,7,10': '7', '0,3,7,10': 'm7', '0,3,6,10': 'm7b5', '0,4,7,11': 'maj7',
+  '0,3,7,11': 'mMaj7', '0,3,6,9': 'dim7', '0,4,8,10': 'aug7', '0,5,7,10': '7sus4',
+};
+
+const IV_BY_QUALITY: Record<string, number[]> = {
+  major: [0, 4, 7], minor: [0, 3, 7], diminished: [0, 3, 6], augmented: [0, 4, 8],
+  '7': [0, 4, 7, 10], maj7: [0, 4, 7, 11], m7: [0, 3, 7, 10], m7b5: [0, 3, 6, 10],
+  dim7: [0, 3, 6, 9], mMaj7: [0, 3, 7, 11], aug7: [0, 4, 8, 10], sus4: [0, 5, 7],
+  sus2: [0, 2, 7], power: [0, 7], '6': [0, 4, 7, 9], m6: [0, 3, 7, 9], '7sus4': [0, 5, 7, 10],
+};
+
+function mkChord(rootPc: number, quality: string, deg: number, fn: Fn, extClass: 0 | 1, borrowed: boolean, cadential = false): VocabChord | null {
+  const iv = IV_BY_QUALITY[quality];
+  if (!iv) return null;
+  const symbol = `${NOTE_NAMES[rootPc]}${SUFFIX[quality] ?? ''}`;
+  const r = parseChord(symbol);
+  if (!r.ok) return null;
+  return { root: r.chord.root, quality, suffix: SUFFIX[quality] ?? '', fn, deg, extClass, parsed: r.chord, borrowed, cadential };
+}
+
+const SEVEN_NOTE = new Set<ModeName>(['Ionian', 'Dorian', 'Phrygian', 'Lydian', 'Mixolydian', 'Aeolian', 'Locrian', 'Harmonic Minor', 'Melodic Minor']);
+
+function buildDiatonicVocab(mode: ModeName, keyPc: number): VocabChord[] {
+  const scale = MODES[mode];
+  const out: VocabChord[] = [];
+  for (let deg = 0; deg < scale.length; deg++) {
+    const stack = (k: number) => scale[(deg + k) % scale.length] + 12 * Math.floor((deg + k) / scale.length) - scale[deg];
+    const triad = [0, stack(2), stack(4)];
+    const seventh = [...triad, stack(6)];
+    const rootPc = (keyPc + scale[deg]) % 12;
+    const triadQ = QUALITY_BY_IV[triad.join(',')];
+    const seventhQ = QUALITY_BY_IV[seventh.join(',')];
+    const fnOf = (q: string): Fn => {
+      if (deg === 0) return 'tonic';
+      if (deg === 4) return 'dominant';
+      if (deg === 3) return 'subdom';
+      if (deg === 5) return q === 'major' || q === '7' || q === 'maj7' ? 'domsub' : 'color';
+      if (deg === 6) return q === 'diminished' || q === 'm7b5' || q === 'dim7' ? 'domsub' : 'color';
+      return deg === 2 ? 'tonic' : 'color';
+    };
+    if (triadQ) { const c = mkChord(rootPc, triadQ, deg, fnOf(triadQ), 0, false); if (c) out.push(c); }
+    if (seventhQ && seventhQ !== triadQ) { const c = mkChord(rootPc, seventhQ, deg, fnOf(seventhQ), 1, false); if (c) out.push(c); }
+  }
+  return out;
+}
+
+/** Exotic strategies: WT aug/7b5 planing, diminished 7b9/°7 on the m3 stack. */
+function buildExoticVocab(mode: ModeName, keyPc: number): VocabChord[] {
+  const out: VocabChord[] = [];
+  const root = (pc: number) => (keyPc + pc) % 12;
+  const pushSym = (r: number, symbol: string, fn: Fn, deg: number) => {
+    const p = parseChord(symbol);
+    if (p.ok) {
+      const q = p.chord.quality;
+      out.push({ root: p.chord.root, quality: q, suffix: symbol.slice(NOTE_NAMES[r].length), fn, deg, extClass: 1, parsed: p.chord, borrowed: false, cadential: false });
+    }
+  };
+  if (mode === 'Whole Tone') {
+    for (let pc = 0; pc < 12; pc += 2) {
+      const r = root(pc);
+      const isTonic = pc === 0;
+      pushSym(r, `${NOTE_NAMES[r]}+`, isTonic ? 'tonic' : 'color', isTonic ? 0 : -1);
+      pushSym(r, `${NOTE_NAMES[r]}7b5`, isTonic ? 'tonic' : 'color', isTonic ? 0 : -1);
+    }
+    return out;
+  }
+  for (const pc of [0, 3, 6, 9]) {
+    const r = root(pc);
+    const isTonic = pc === 0;
+    pushSym(r, `${NOTE_NAMES[r]}7b9`, isTonic ? 'tonic' : 'dominant', isTonic ? 0 : -1);
+    pushSym(r, `${NOTE_NAMES[r]}°7`, isTonic ? 'tonic' : 'color', isTonic ? 0 : -1);
+  }
+  return out;
+}
+
+/**
+ * Free functional chords in EVERY mode (user decision: "keep V and vii° allowed
+ * in minor — do not disqualify them as borrowed", generalised): the dominant on
+ * degree 5 (major triad + dom7) and the leading-tone chord on degree 11.
+ * Never count against the borrow cap, never disqualified.
+ */
+function buildFreeFunctional(keyPc: number, home: VocabChord[]): VocabChord[] {
+  const have = new Set(home.map((c) => `${c.root}:${c.quality}`));
+  const out: VocabChord[] = [];
+  const add = (iv: number, quality: string, fn: Fn) => {
+    if (have.has(`${(keyPc + iv) % 12}:${quality}`)) return;
+    const c = mkChord((keyPc + iv) % 12, quality, iv === 7 ? 4 : 6, fn, quality === '7' ? 1 : 0, false, true);
+    if (c) out.push(c);
+  };
+  add(7, 'major', 'dominant');
+  add(7, '7', 'dominant');
+  add(11, 'diminished', 'domsub');
+  add(11, 'm7b5', 'domsub');
+  add(11, 'dim7', 'domsub');
+  return out;
+}
+
+/**
+ * Whitelisted borrowed chords per mode (exact lists agreed with the user).
+ * Intervals are semitones from the tonic. Entries already diatonic are dropped.
+ * Borrowed chords: mid-phrase only, max 1 per phrase, max 1 per 4 bars.
+ */
+const BORROW_TABLE: Record<ModeName, [number, string][]> = {
+  'Ionian':                 [[3, 'major'], [5, 'minor'], [8, 'major'], [10, 'major'], [2, 'major']], // bIII, iv, bVI, bVII, V/V
+  'Dorian':                 [[8, 'major'], [5, 'minor']],                                                              // bVI, iv
+  'Phrygian':               [[5, 'major']],                                                                            // IV (Dorian brightness)
+  'Lydian':                 [[5, 'major'], [10, 'major']],                                                             // IV, bVII
+  'Mixolydian':             [[5, 'minor']],                                                                            // iv
+  'Aeolian':                [[5, 'major']],                                                                            // IV (V / vii° are free, see above)
+  'Locrian':                [],                                                                                        // nothing beyond V (free)
+  'Harmonic Minor':         [[5, 'major'], [10, 'major']],                                                             // IV, bVII (V / vii° native)
+  'Melodic Minor':          [[8, 'major'], [10, 'major']],                                                             // bVI, bVII
+  'Whole Tone':             [],
+  'Diminished (Half-Whole)': [],
+  'Diminished (Whole-Half)': [],
+};
+
+function buildBorrowedPool(mode: ModeName, keyPc: number, home: VocabChord[]): VocabChord[] {
+  if (!SEVEN_NOTE.has(mode)) return [];
+  const have = new Set(home.map((c) => `${c.root}:${c.quality}`));
+  const seen = new Set<string>();
+  const out: VocabChord[] = [];
+  for (const [iv, quality] of BORROW_TABLE[mode]) {
+    const root = (keyPc + iv) % 12;
+    const key = `${root}:${quality}`;
+    if (have.has(key) || seen.has(key)) continue;
+    seen.add(key);
+    const extClass: 0 | 1 = ['7'].includes(quality) ? 1 : 0;
+    const c = mkChord(root, quality, -1, iv === 5 ? 'subdom' : 'color', extClass, true);
+    if (c) out.push(c);
+  }
+  return out;
+}
+
+function buildVocab(mode: ModeName, keyPc: number): { home: VocabChord[]; free: VocabChord[]; borrowed: VocabChord[] } {
+  const home = SEVEN_NOTE.has(mode) ? buildDiatonicVocab(mode, keyPc) : buildExoticVocab(mode, keyPc);
+  const free = buildFreeFunctional(keyPc, home);
+  const borrowed = buildBorrowedPool(mode, keyPc, [...home, ...free]);
+  return { home, free, borrowed };
+}
+
+/* ============================ Section profiles ============================ */
+
+type ProfileKey = 'intro' | 'verse' | 'prechorus' | 'build' | 'chorus' | 'bridge' | 'breakdown' | 'outro';
+
+interface Profile {
+  /** Musical energy 0..1 — drives chord-change pace (slow intro, fast chorus). */
+  energy: number;
+  tension: [number, number];
+  maxExt: 0 | 1;
+  borrow: boolean;
+  shape: 'flat' | 'rise' | 'plateau' | 'vshape' | 'decay';
+}
+
+const PROFILES: Record<ProfileKey, Profile> = {
+  intro:     { energy: 0.15, tension: [0.10, 0.25], maxExt: 0, borrow: false, shape: 'flat' },
+  verse:     { energy: 0.40, tension: [0.22, 0.42], maxExt: 1, borrow: true,  shape: 'flat' },
+  prechorus: { energy: 0.65, tension: [0.35, 0.62], maxExt: 1, borrow: true,  shape: 'rise' },
+  build:     { energy: 0.72, tension: [0.35, 0.70], maxExt: 1, borrow: false, shape: 'rise' },
+  chorus:    { energy: 0.80, tension: [0.45, 0.70], maxExt: 1, borrow: true,  shape: 'plateau' },
+  bridge:    { energy: 0.45, tension: [0.35, 0.62], maxExt: 1, borrow: true,  shape: 'vshape' },
+  breakdown: { energy: 0.12, tension: [0.15, 0.30], maxExt: 0, borrow: false, shape: 'flat' },
+  outro:     { energy: 0.30, tension: [0.00, 0.40], maxExt: 1, borrow: false, shape: 'decay' },
+};
+
+export function resolveProfileKey(name: string): ProfileKey {
+  const n = name.trim().toLowerCase();
+  if (/intro|prelude|overture/.test(n)) return 'intro';
+  if (/pre-?chorus|rise|lift|prebuild/.test(n)) return 'prechorus';
+  if (/build/.test(n)) return 'build';
+  if (/chorus|refrain|hook|drop/.test(n)) return 'chorus';
+  if (/bridge|middle|interlude/.test(n)) return 'bridge';
+  if (/breakdown|solo|break/.test(n)) return 'breakdown';
+  if (/outro|coda|finale|fade|ending/.test(n)) return 'outro';
+  return 'verse';
+}
+
+/* ============================ Phrase grid ============================ */
+
+export type CadenceKind = 'open' | 'resolve' | 'finalTonic';
+
+interface Phrase { start: number; end: number; cadence: CadenceKind }
+
+/** 4-bar phrases + one shorter remainder phrase; cadence by position. */
+function phraseGrid(sectionStartTick: number, sectionBars: number, barT: number, songEnd: boolean): Phrase[] {
+  const phrases: Phrase[] = [];
+  const full = Math.floor(sectionBars / 4);
+  const rem = sectionBars - full * 4;
+  let b = 0;
+  for (let i = 0; i < full; i++, b += 4) phrases.push({ start: sectionStartTick + b * barT, end: sectionStartTick + (b + 4) * barT, cadence: 'open' });
+  if (rem > 0) phrases.push({ start: sectionStartTick + b * barT, end: sectionStartTick + sectionBars * barT, cadence: 'open' });
+  if (phrases.length) phrases[phrases.length - 1].cadence = songEnd ? 'finalTonic' : 'resolve';
+  return phrases;
+}
+
+/* ============================ Slot layout ============================ */
+
+interface Slot { start: number; dur: number; end: number; cadence: CadenceKind | null; deceptive: boolean; isPhraseStart: boolean; phraseIdx: number }
+
+/** Mean chord length in bars from section energy (slow sections hold, climaxes move). */
+const targetChordBars = (e: number) => Math.max(0.55, Math.min(3.2, 2.4 - 2.0 * e));
+
+/**
+ * Lay ONE phrase-aligned segment of a free region into chord slots: durations
+ * generated from the pace target, minimum half a bar rounded to whole beats,
+ * internal starts on felt beats, the segment filled exactly. If the segment
+ * closes a phrase, its final slot carries that phrase's cadence.
+ */
+function layoutSegment(
+  segStart: number, segEnd: number, cadence: CadenceKind | null, phraseStart: number | null, phraseIdx: number,
+  beatT: number, minBeats: number, targetBeats: number, rng: () => number,
+): Slot[] {
+  const totalBeats = (segEnd - segStart) / beatT;
+  if (totalBeats < 0.999) return []; // sliver narrower than one beat: cannot host a beat-start chord
+  const slots: Slot[] = [];
+  let pos = 0;
+  let rem = totalBeats;
+  for (let guard = 0; rem > 0.001 && guard < 256; guard++) {
+    let beats: number;
+    if (rem < minBeats * 2) beats = rem; // close out the segment
+    else {
+      const jitter = 0.7 + rng() * 0.7;
+      beats = Math.max(minBeats, Math.min(rem - minBeats, Math.round(targetBeats * jitter)));
+    }
+    const startTick = Math.round(segStart + pos * beatT);
+    let endTick = Math.round(segStart + (pos + beats) * beatT);
+    if (pos + beats >= totalBeats - 0.001) endTick = segEnd; // last slot closes the segment exactly
+    slots.push({
+      start: startTick, end: endTick, dur: endTick - startTick,
+      cadence: null, deceptive: false,
+      isPhraseStart: phraseStart !== null && startTick === phraseStart, phraseIdx,
+    });
+    pos += beats;
+    rem -= beats;
+  }
+  if (slots.length && cadence !== null) {
+    const last = slots[slots.length - 1];
+    if (last.end === segEnd) {
+      last.cadence = cadence;
+      last.deceptive = cadence === 'resolve' && slots.length > 1 && rng() < 0.18;
+    }
+  }
+  return slots;
+}
+
+/* ============================ Walk + score ============================ */
+
+const rootDiff = (a: number, b: number) => (((b - a) % 12) + 12) % 12;
+const sharedPcs = (a: ParsedChord, b: ParsedChord) => {
+  const sb = new Set(b.pitchClasses);
+  return a.pitchClasses.filter((p) => sb.has(p)).length;
+};
+function targetTensionAt(profile: Profile, pos: number): number {
+  const [lo, hi] = profile.tension;
+  switch (profile.shape) {
+    case 'flat': return (lo + hi) / 2;
+    case 'rise': return lo + (hi - lo) * pos;
+    case 'plateau': return (lo + hi) / 2;
+    case 'vshape': return pos < 0.5 ? lo + 0.08 * (pos / 0.5) : lo + 0.08 + (hi - lo - 0.08) * ((pos - 0.5) / 0.5);
+    case 'decay': return hi + (lo - hi) * pos;
+  }
+}
+
+/** Motion quality 0..1 for a root interval (semitones up). */
+function motionQuality(dm: number): number {
+  const a = Math.min(dm, 12 - dm);
+  if (a === 0) return 0.85; // same root, different quality (Dm -> Dm7): smooth common-tone move; exact repeats are filtered earlier
+  if (a === 5 || a === 7) return 1.0;      // 4th / 5th — strong
+  if (a === 1 || a === 2) return 0.9;      // stepwise — smooth
+  if (a === 3 || a === 4) return 0.65;     // third — neutral
+  if (a === 6) return 0.15;                // tritone — harsh
+  return 0.45;                             // 6th leaps
+}
+
+interface Wall { start: number; end: number; key: string | null } // key = "root:quality" of a parsable chord
+
+const wallOf = (c: Chord): Wall => {
+  const r = parseChord(c.symbol);
+  return { start: c.startTick, end: c.startTick + c.durationTicks, key: r.ok ? `${r.chord.root}:${r.chord.quality}` : null };
+};
+
+interface GapCtx { start: number; end: number; before: Wall | null; after: Wall | null }
+
+interface WalkInput {
+  gaps: GapCtx[];
+  phrases: Phrase[];
+  sectionBars: number;
+  profile: Profile;
+  shape: { startDeg: number };
+  home: VocabChord[]; free: VocabChord[]; borrowed: VocabChord[];
+  keyPc: number; mode: ModeName; barT: number; beatT: number;
+  tonicFirst: boolean; tonicLast: boolean;
+  deceptiveTarget: { root: number; quality: string };
+  rng: () => number;
+}
+
+interface WalkOutput {
+  picks: { slot: Slot; chord: VocabChord }[];
+  score: number;
+  stats: { downbeatFrac: number; paceMatch: number; motionQ: number; variety: number; edgeQ: number };
+}
+
+/** One candidate realisation of a section: generated rhythm + chord choices, scored. */
+function buildCandidate(input: WalkInput): WalkOutput | null {
+  const { gaps, phrases, profile, shape, home, free, borrowed, keyPc, mode, barT, beatT, rng } = input;
+  const exotic = !SEVEN_NOTE.has(mode);
+  const sectionSpanStart = gaps.length ? gaps[0].start : 0;
+  const sectionSpanEnd = gaps.length ? gaps[gaps.length - 1].end : 0;
+  const phraseIdxOf = (tick: number) => {
+    for (let i = 0; i < phrases.length; i++) if (tick >= phrases[i].start && tick < phrases[i].end) return i;
+    return phrases.length - 1;
+  };
+
+  // Layout every gap, split at phrase boundaries so slots close exactly on phrase ends.
+  const minBeats = Math.max(1, Math.round(barT / beatT / 2));
+  const laid: { gap: GapCtx; slots: Slot[] }[] = [];
+  for (const gap of gaps) {
+    const slots: Slot[] = [];
+    const span = Math.max(1, sectionSpanEnd - sectionSpanStart);
+    for (let pi = 0; pi < phrases.length; pi++) {
+      const p = phrases[pi];
+      const segStart = Math.max(gap.start, p.start);
+      const segEnd = Math.min(gap.end, p.end);
+      if (segEnd - segStart < beatT) continue;
+      const closesPhrase = segEnd === p.end;
+      const posInSection = Math.max(0, Math.min(1, (segStart - sectionSpanStart) / span));
+      let targetBeats = targetChordBars(profile.energy) * (barT / beatT);
+      if (profile.shape === 'rise') targetBeats *= 1 - 0.45 * posInSection; // build accelerates toward the peak
+      slots.push(...layoutSegment(segStart, segEnd, closesPhrase ? p.cadence : null, p.start, pi, beatT, minBeats, targetBeats, rng));
+    }
+    laid.push({ gap, slots });
+  }
+  const allSlots = laid.flatMap((l) => l.slots);
+  if (!allSlots.length) return null;
+
+  // Recurrence bookkeeping per phrase, pre-seeded with wall chords inside each phrase.
+  const phraseRec = phrases.map(() => new Map<string, number>());
+  const phraseBorrow = phrases.map(() => 0);
+  for (const g of gaps) {
+    for (const w of [g.before, g.after]) {
+      if (!w?.key) continue;
+      const pi = phraseIdxOf(Math.max(0, w.start));
+      if (phrases[pi] && w.end > phrases[pi].start && w.start < phrases[pi].end) phraseRec[pi].set(w.key, (phraseRec[pi].get(w.key) ?? 0) + 1);
+    }
+  }
+
+  const borrowCap = Math.max(1, Math.ceil(input.sectionBars / 4));
+  let sectionBorrow = 0;
+  const tonicPool = home.filter((c) => c.root === keyPc && c.fn === 'tonic');
+  const vocabAll = [...home, ...free];
+
+  const picks: { slot: Slot; chord: VocabChord }[] = [];
+  let prevKey: string | null = null; // "root:quality"
+  let prevPrevKey: string | null = null;
+  let prevParsed: ParsedChord | null = null;
+  let prevRoot: number | null = null;
+  const motionScores: number[] = [];
+  const pingpong: boolean[] = [];
+  let downbeats = 0;
+
+  for (let si = 0; si < allSlots.length; si++) {
+    const slot = allSlots[si];
+    const isLastGenerated = si === allSlots.length - 1;
+    const gapOfSlot = laid.find((l) => l.slots.includes(slot))!;
+    const atGapStart = slot.start === gapOfSlot.gap.start;
+    const atGapEnd = slot.end === gapOfSlot.gap.end;
+
+    // Entry wall constraint: no direct repeat, recorded for motion scoring.
+    if (atGapStart && gapOfSlot.gap.before?.key) { prevKey = gapOfSlot.gap.before.key; prevParsed = null; prevRoot = parseInt(prevKey, 10); }
+
+    const rec = phraseRec[slot.phraseIdx];
+    const posInSection = Math.max(0, Math.min(1, (slot.start - sectionSpanStart) / Math.max(1, sectionSpanEnd - sectionSpanStart)));
+    const target = targetTensionAt(profile, posInSection);
+
+    const eligible: { c: VocabChord; s: number }[] = [];
+    const allowBorrow = profile.borrow && !exotic && slot.cadence === null && phraseBorrow[slot.phraseIdx] < 1 && sectionBorrow < borrowCap;
+    const pool = allowBorrow ? [...vocabAll, ...borrowed] : vocabAll;
+
+    for (const c of pool) {
+      if (c.extClass > profile.maxExt && !(c.cadential && c.extClass === 1)) continue;
+      const key = `${c.root}:${c.quality}`;
+      if (prevKey === key) continue; // hard rule 4: no direct repeat (root+quality)
+      if (atGapEnd && gapOfSlot.gap.after?.key === key) continue; // never repeat into the next wall
+      if (!exotic && prevParsed) {
+        const dm = rootDiff(prevParsed.root, c.root);
+        if (dm === 6 && !(hasTritone(prevParsed.pitchClasses) && (c.fn === 'tonic' || c.fn === 'dominant'))) continue;
+        const shared = sharedPcs(prevParsed, c.parsed);
+        if ((dm === 5 || dm === 7) && shared < 1) continue;
+        if ((dm === 3 || dm === 4 || dm === 8 || dm === 9) && shared < 2) continue;
+      }
+      if ((rec.get(key) ?? 0) >= 2) continue; // soft rule: same chord ≤ 2 per phrase (hard-enforced)
+      if (c.borrowed) continue; // placeholder replaced below when allowBorrow pool contains borrowed chords
+      // Cadence constraints (hard rule 2)
+      if (slot.cadence === 'open' && c.root === keyPc) continue;
+      if (slot.cadence === 'resolve') {
+        if (slot.deceptive) { if (!(c.root === input.deceptiveTarget.root && c.quality === input.deceptiveTarget.quality)) continue; }
+        else if (c.root !== keyPc) continue;
+      }
+      if (slot.cadence === 'finalTonic') {
+        if (c.root !== keyPc) continue;
+        if (tonicPool.some((t) => t.extClass === 0) && c.extClass !== 0 && !c.cadential) continue;
+      }
+      if (input.tonicFirst && si === 0 && atGapStart && c.root !== keyPc) continue; // hard rule 3a
+      if (input.tonicLast && isLastGenerated && atGapEnd && c.root !== keyPc) continue; // hard rule 3b
+      let s = 1 - Math.abs(chordTension(c.parsed, keyPc) - target) * 1.2;
+      if (prevRoot !== null) {
+        const dm = rootDiff(prevRoot, c.root);
+        s += (motionQuality(dm) - 0.6) * 0.25;
+      }
+      if (prevPrevKey !== null && key === prevPrevKey) s -= 0.22; // anti ping-pong: A B A B oscillation is a scoring artifact, not variety
+      if (slot.isPhraseStart && c.deg === shape.startDeg) s += 0.1; // shared shape: phrase starts on the shape's degree
+      if (slot.start % barT === 0) s += 0.05; // strong-beat landings
+      if (c.borrowed) s += 0.06; // colour bonus (capped elsewhere)
+      s += rng() * 0.04;
+      eligible.push({ c, s });
+    }
+    // Borrowed chords only enter when allowed (placeholder above skipped them).
+    if (allowBorrow) {
+      for (const c of borrowed) {
+        if (c.extClass > profile.maxExt) continue;
+        const key = `${c.root}:${c.quality}`;
+        if (prevKey === key) continue;
+        if (atGapEnd && gapOfSlot.gap.after?.key === key) continue;
+        if (!exotic && prevParsed) {
+          const dm = rootDiff(prevParsed.root, c.root);
+          if (dm === 6) continue;
+          const shared = sharedPcs(prevParsed, c.parsed);
+          if ((dm === 5 || dm === 7) && shared < 1) continue;
+          if ((dm === 3 || dm === 4 || dm === 8 || dm === 9) && shared < 2) continue;
+        }
+        if ((rec.get(key) ?? 0) >= 2) continue;
+        if (slot.cadence !== null) continue; // never at a phrase end
+        let s = 0.7 - Math.abs(chordTension(c.parsed, keyPc) - target) * 0.8 + 0.1 + rng() * 0.04;
+        if (prevRoot !== null) s += (motionQuality(rootDiff(prevRoot, c.root)) - 0.6) * 0.25;
+        eligible.push({ c, s });
+      }
+    }
+    if (!eligible.length) return null; // candidate failed — another seed offset will try differently
+
+    eligible.sort((a, b) => b.s - a.s);
+    const pick = eligible[0].c;
+    const pickKey = `${pick.root}:${pick.quality}`;
+    if (pick.borrowed) { phraseBorrow[slot.phraseIdx]++; sectionBorrow++; }
+    rec.set(pickKey, (rec.get(pickKey) ?? 0) + 1);
+    if (slot.start % barT === 0) downbeats++;
+    if (prevRoot !== null) motionScores.push(motionQuality(rootDiff(prevRoot, pick.root)));
+    pingpong.push(prevPrevKey === pickKey);
+    // Exit-wall constraint feeds the next entry via prevKey below.
+    if (atGapEnd && gapOfSlot.gap.after?.key) {
+      const nk = gapOfSlot.gap.after.key;
+      motionScores.push(motionQuality(rootDiff(pick.root, parseInt(nk, 10))));
+      prevKey = null; prevParsed = null; prevRoot = null; prevPrevKey = null; // next gap re-seeds from its own wall
+    } else {
+      prevPrevKey = prevKey;
+      prevKey = pickKey;
+      prevParsed = pick.parsed;
+      prevRoot = pick.root;
+    }
+    picks.push({ slot, chord: pick });
+  }
+
+  /* ---- section score (0..1) ---- */
+  const n = picks.length;
+  const downbeatFrac = n ? downbeats / n : 0;
+  const targetCPB = 1 / targetChordBars(profile.energy);
+  const actualCPB = n / Math.max(0.25, (sectionSpanEnd - sectionSpanStart) / barT);
+  const paceMatch = Math.max(0, 1 - Math.abs(actualCPB - targetCPB) / Math.max(targetCPB, actualCPB, 0.01)); // relative miss — tiny sections are not punished for being short
+  const motionQ = motionScores.length ? motionScores.reduce((a, b) => a + b, 0) / motionScores.length : 0.7;
+  const keys = new Set(picks.map((p) => `${p.chord.root}:${p.chord.quality}`));
+  const pingFrac = pingpong.length ? pingpong.filter(Boolean).length / pingpong.length : 0;
+  const variety = n ? Math.max(0, keys.size / n - 0.6 * pingFrac) : 0; // oscillation eats the variety credit
+  const firstEdge = gaps[0]?.before?.key ? motionQuality(rootDiff(parseInt(gaps[0].before.key, 10), picks[0].chord.root)) : 0.8;
+  const lastGap = gaps[gaps.length - 1];
+  const lastEdge = lastGap?.after?.key ? motionQuality(rootDiff(picks[n - 1].chord.root, parseInt(lastGap.after.key, 10))) : 0.8;
+  const edgeQ = (firstEdge + lastEdge) / 2;
+  const score = 0.22 * downbeatFrac + 0.24 * paceMatch + 0.30 * Math.min(1, motionQ) + 0.12 * Math.min(1, variety) + 0.12 * Math.min(1, edgeQ);
+  return { picks, score, stats: { downbeatFrac, paceMatch, motionQ, variety, edgeQ } };
+}
+
+/* ============================ Fallback bank ============================ */
+
+type DegStep = [deg: number, frac: number];
+const FB_OPEN: DegStep[][] = [
+  [[0, 0.5], [3, 0.25], [4, 0.25]],
+  [[5, 0.25], [3, 0.25], [0, 0.25], [4, 0.25]],
+  [[0, 0.5], [6, 0.25], [3, 0.25]],
+];
+const FB_RESOLVE: DegStep[][] = [
+  [[0, 0.25], [3, 0.25], [4, 0.25], [0, 0.25]],
+  [[0, 0.5], [3, 0.25], [0, 0.25]],
+];
+const FB_FINAL: DegStep[][] = [
+  [[3, 0.5], [4, 0.25], [0, 0.25]],
+  [[0, 0.5], [3, 0.25], [0, 0.25]],
+  [[5, 0.25], [3, 0.25], [4, 0.25], [0, 0.25]],
+];
+
+function chordForDeg(deg: number, home: VocabChord[], keyPc: number): VocabChord | null {
+  const at = home.filter((c) => c.deg === deg);
+  if (at.length) return at.find((c) => c.extClass === 0) ?? at[0];
+  const byFn: Record<number, Fn> = { 0: 'tonic', 3: 'subdom', 4: 'dominant' };
+  const fn = byFn[deg] ?? 'color';
+  return home.find((c) => c.fn === fn && c.extClass === 0) ?? home.find((c) => c.fn === fn) ?? home.find((c) => c.root === keyPc) ?? home[0] ?? null;
+}
+
+/** A tonic-rooted vocab chord, avoiding one root:quality key if possible. */
+function tonicVariant(home: VocabChord[], keyPc: number, avoid: string | null): VocabChord | null {
+  const tonics = home.filter((c) => c.root === keyPc && c.fn === 'tonic');
+  return tonics.find((c) => `${c.root}:${c.quality}` !== avoid) ?? tonics[0] ?? null;
+}
+
+/** Safe built-in progression for a section — used only when every candidate scores below the floor. */
+function buildFallback(input: Omit<WalkInput, 'rng'>, rng: () => number): { picks: { slot: Slot; chord: VocabChord }[]; score: number } {
+  const { gaps, phrases, home, keyPc, mode, barT, beatT, tonicFirst, tonicLast } = input;
+  const exotic = !SEVEN_NOTE.has(mode);
+  const picks: { slot: Slot; chord: VocabChord }[] = [];
+  const tonicChord = chordForDeg(0, home, keyPc);
+  const minBeats = Math.max(1, Math.round(barT / beatT / 2));
+  let prevKey: string | null = null;
+  let firstPlaced = false;
+  for (const gap of gaps) {
+    for (let pi = 0; pi < phrases.length; pi++) {
+      const p = phrases[pi];
+      const segStart = Math.max(gap.start, p.start);
+      const segEnd = Math.min(gap.end, p.end);
+      if (segEnd - segStart < beatT) continue;
+      const closesPhrase = segEnd === p.end;
+      const cadence: CadenceKind = closesPhrase ? p.cadence : 'open';
+      const bank = closesPhrase ? (p.cadence === 'finalTonic' ? FB_FINAL : p.cadence === 'resolve' ? FB_RESOLVE : FB_OPEN) : FB_OPEN;
+      const totalBeats = (segEnd - segStart) / beatT;
+      // Allocate whole min-beat units so every fallback chord respects the minimum length,
+      // keeping the template's tail (the cadence element always survives).
+      const units = Math.max(1, Math.floor(totalBeats / minBeats));
+      const k = Math.min(bank[0].length, units); // template length (all bank entries share shapes)
+      const tmpl = bank[Math.floor(rng() * bank.length)].slice(-k);
+      const sum = tmpl.reduce((a, s) => a + s[1], 0);
+      const u = tmpl.map((s) => Math.max(1, Math.floor((s[1] / sum) * units)));
+      let assigned = u.reduce((a, b) => a + b, 0);
+      while (assigned < units) { u[u.length - 1]++; assigned++; } // spare units lengthen the cadence chord
+      let pos = 0;
+      for (let i = 0; i < tmpl.length; i++) {
+        const [deg] = tmpl[i];
+        const isLast = i === tmpl.length - 1;
+        const beats = isLast ? totalBeats - pos : u[i] * minBeats;
+        if (beats < 0.5) continue;
+        let chord: VocabChord | null = exotic
+          ? (closesPhrase && cadence === 'open' && isLast ? home.find((c) => c.root !== keyPc) ?? tonicChord : tonicChord)
+          : chordForDeg(deg, home, keyPc);
+        if (!chord) continue;
+        // Hard tonic edges in fallbacks too: song start / song end.
+        if (tonicFirst && !firstPlaced) chord = tonicVariant(home, keyPc, null) ?? chord;
+        if (tonicLast && isLast && pi === phrases.length - 1 && gap === gaps[gaps.length - 1]) chord = tonicVariant(home, keyPc, prevKey) ?? chord;
+        const key: string = `${chord.root}:${chord.quality}`;
+        if (key === prevKey) { pos += beats; continue; } // no direct repeat across the seam
+        const startTick = Math.round(segStart + pos * beatT);
+        const endTick = isLast ? segEnd : Math.round(segStart + (pos + beats) * beatT);
+        if (endTick <= startTick) continue;
+        picks.push({
+          slot: { start: startTick, end: endTick, dur: endTick - startTick, cadence: isLast && closesPhrase ? cadence : null, deceptive: false, isPhraseStart: startTick === p.start, phraseIdx: pi },
+          chord,
+        });
+        prevKey = `${chord.root}:${chord.quality}`;
+        firstPlaced = true;
+        pos += beats;
+      }
+      if (pos < totalBeats - 0.001) {
+        // rounding residue: one closing chord — never a direct repeat of what came before
+        const isSongEnd = tonicLast && pi === phrases.length - 1 && gap === gaps[gaps.length - 1];
+        const tonicRepeats: boolean = (!tonicChord || `${tonicChord.root}:${tonicChord.quality}` === prevKey) && !isSongEnd;
+        const chord: VocabChord | null = tonicRepeats ? chordForDeg(3, home, keyPc) ?? chordForDeg(4, home, keyPc) ?? tonicChord : tonicVariant(home, keyPc, prevKey) ?? tonicChord;
+        if (chord && `${chord.root}:${chord.quality}` !== prevKey) {
+          const startTick = Math.round(segStart + pos * beatT);
+          picks.push({ slot: { start: startTick, end: segEnd, dur: segEnd - startTick, cadence: closesPhrase ? cadence : null, deceptive: false, isPhraseStart: false, phraseIdx: pi }, chord });
+          prevKey = `${chord.root}:${chord.quality}`;
+        }
+      }
+    }
+  }
+  return { picks, score: SCORE_FLOOR + 0.01 };
+}
+
+/* ============================ Main entry ============================ */
+
+function projectBarsFallback(project: Project, barT: number): number {
+  let bars = 0;
+  for (const c of project.chords) bars = Math.max(bars, Math.ceil((c.startTick + c.durationTicks) / barT));
+  return bars || 8;
+}
+
+export function generateProgressionDetailed(project: Project, options: ProgressionOptions): ProgressionResult {
+  const seed = Math.round(options.seed);
+  const ts = project.timeSignature;
+  const barT = barTicks(ts);
+  const beatT = beatTicks(ts);
+  const mode = project.mode as ModeName;
+  const keyPc = project.key;
+  const rerollId = options.rerollSectionId;
+  const scope: GenScope = rerollId ? 'section' : options.scope ?? 'empty';
+
+  let sections: Section[] = [...project.sections].sort((a, b) => a.startBar - b.startBar);
+  if (!sections.length) sections = [{ id: '__all', name: 'Verse', startBar: 1, lengthBars: projectBarsFallback(project, barT) }];
+  const targetId = rerollId ?? options.sectionId;
+  const regionSections = scope === 'section'
+    ? sections.filter((s) => s.id === targetId)
+    : sections;
+  if (!regionSections.length) return { chords: [...project.chords], reports: [], fallbackCount: 0 };
+
+  const regionStart = (regionSections[0].startBar - 1) * barT;
+  const regionEnd = (regionSections[regionSections.length - 1].startBar - 1 + regionSections[regionSections.length - 1].lengthBars) * barT;
+  const { home, free, borrowed } = buildVocab(mode, keyPc);
+  const tonicHome = home.find((c) => c.root === keyPc && c.fn === 'tonic');
+  const tonicQ = tonicHome?.quality ?? 'major';
+  const deceptiveTarget = tonicQ === 'major'
+    ? { root: (keyPc + 9) % 12, quality: 'minor' }   // V -> vi
+    : { root: (keyPc + 8) % 12, quality: 'major' };  // V -> bVI
+
+  // Walls & kept chords by scope (user decision #7).
+  const kept: Chord[] = [];
+  const walls: Wall[] = [];
+  const replacedIds = new Set<string>();
+  for (const c of project.chords) {
+    const overlapsRegion = c.startTick < regionEnd && c.startTick + c.durationTicks > regionStart;
+    if (scope === 'empty') { walls.push(wallOf(c)); kept.push(c); }
+    else if (scope === 'all') {
+      if (c.locked === true) { walls.push(wallOf(c)); kept.push(c); }
+      else if (overlapsRegion) replacedIds.add(c.id);
+    } else {
+      if (overlapsRegion) {
+        if (c.locked === true) { walls.push(wallOf(c)); kept.push(c); }
+        else replacedIds.add(c.id);
+      } else kept.push(c); // outside the region: untouched, boundary-only
+    }
+  }
+  const generated: Chord[] = []; // sections generated earlier in this pass; filled as we go
+  const reports: SectionReport[] = [];
+  let fallbackCount = 0;
+
+  // Neighbor lookups scan only KEPT chords (never replaced ones) + what this pass has generated.
+  const chordBefore = (tick: number): Wall | null => {
+    let best: Wall | null = null;
+    for (const c of kept) {
+      const end = c.startTick + c.durationTicks;
+      if (end <= tick && (!best || end > best.end)) best = wallOf(c);
+    }
+    for (const g of generated) {
+      const end = g.startTick + g.durationTicks;
+      if (end <= tick && (!best || end > best.end)) best = wallOf(g);
+    }
+    return best;
+  };
+  const chordAfter = (tick: number): Wall | null => {
+    let best: Wall | null = null;
+    for (const c of kept) {
+      if (c.startTick >= tick && (best === null || c.startTick < best.start)) best = wallOf(c);
+    }
+    for (const g of generated) {
+      if (g.startTick >= tick && (best === null || g.startTick < best.start)) best = wallOf(g);
+    }
+    return best;
+  };
+
+  const noChordBefore = !kept.some((c) => c.startTick < regionStart) && !generated.length;
+  const noChordAfter = !kept.some((c) => c.startTick + c.durationTicks > regionEnd);
+  const isLastRegionSection = (s: Section) => s.id === regionSections[regionSections.length - 1].id;
+
+  for (const section of regionSections) {
+    const profileKey = resolveProfileKey(section.name);
+    const profile = PROFILES[profileKey];
+    const secStart = (section.startBar - 1) * barT;
+    const secEnd = secStart + section.lengthBars * barT;
+    const songEnd = isLastRegionSection(section) && noChordAfter; // scope reaches the song end: final chord must be tonic
+    const phrases = phraseGrid(secStart, section.lengthBars, barT, songEnd);
+
+    // Free gaps between walls inside this section.
+    const wallsHere = walls.filter((w) => w.start < secEnd && w.end > secStart).sort((a, b) => a.start - b.start);
+    const gaps: GapCtx[] = [];
+    let cursor = secStart;
+    for (const w of wallsHere) {
+      if (w.start > cursor) gaps.push({ start: cursor, end: Math.min(w.start, secEnd), before: null, after: null });
+      cursor = Math.max(cursor, w.end);
+      if (cursor >= secEnd) break;
+    }
+    if (cursor < secEnd) gaps.push({ start: cursor, end: secEnd, before: null, after: null });
+    for (const g of gaps) { g.before = chordBefore(g.start); g.after = chordAfter(g.end); }
+    if (!gaps.length) { reports.push({ sectionId: section.id, name: section.name, chordCount: 0, score: 1, fallback: false }); continue; }
+
+    // Shape: same type shares hash(seed, type); a re-roll replaces this section's shape (user decision #5).
+    const shapeSeed = rerollId ? hashString(`shape|${seed}|${section.id}|reroll`) : hashString(`shape|${seed}|${profileKey}`);
+    const shapeRng = mulberry32(shapeSeed);
+    const shape = { startDeg: [0, 0, 5, 3][Math.floor(shapeRng() * 4)] }; // phrase-start degree preference
+    const subSeed = hashString(`section|${seed}|${section.id}|${section.startBar}|${section.lengthBars}`);
+
+    const tonicFirst = noChordBefore && gaps[0].start === secStart && section.id === regionSections[0].id;
+    const tonicLast = noChordAfter && isLastRegionSection(section) && gaps[gaps.length - 1].end === secEnd;
+
+    const baseInput = {
+      gaps, phrases, sectionBars: section.lengthBars, profile, shape, home, free, borrowed,
+      keyPc, mode, barT, beatT, tonicFirst, tonicLast, deceptiveTarget,
+    };
+
+    let best: { picks: { slot: Slot; chord: VocabChord }[]; score: number } | null = null;
+    for (let ci = 0; ci < CANDIDATES_PER_SECTION; ci++) {
+      const rng = mulberry32((subSeed ^ hashString(`cand${ci}`)) >>> 0);
+      const out = buildCandidate({ ...baseInput, rng });
+      if (!out) continue;
+      if (!best || out.score > best.score) best = out;
+      if (best.score >= 0.85) break;
+    }
+    let fallback = false;
+    if (!best || best.score < SCORE_FLOOR) {
+      best = buildFallback({ ...baseInput }, mulberry32((subSeed ^ hashString('fallback')) >>> 0));
+      fallback = true;
+      fallbackCount++;
+    }
+
+    for (const p of best.picks) {
+      generated.push({ id: uid('chd'), symbol: p.chord.parsed.symbol, startTick: p.slot.start, durationTicks: Math.max(1, p.slot.dur) });
+    }
+    reports.push({ sectionId: section.id, name: section.name, chordCount: best.picks.length, score: best.score, fallback });
+  }
+
+  const out = [...kept.filter((c) => !replacedIds.has(c.id)), ...generated].filter((c) => parseChord(c.symbol).ok);
+  out.sort((a, b) => a.startTick - b.startTick || a.durationTicks - b.durationTicks);
+  return { chords: out, reports, fallbackCount };
+}
+
+export function generateProgression(project: Project, options: ProgressionOptions): Chord[] {
+  return generateProgressionDetailed(project, options).chords;
+}
+
+/* ============================ Audit (tests + seed dump) ============================ */
+
+export interface AuditIssue { rule: string; detail: string }
+
+/**
+ * Re-checks every hard rule on a finished progression. Used by the test
+ * harness (1000 seeds) and the seed-audit dump — generation itself never
+ * relies on this; the rules are built into the walk.
+ */
+export function auditProgression(project: Project, chords: Chord[], ignoreIds?: Set<string>): AuditIssue[] {
+  const issues: AuditIssue[] = [];
+  const bad = (rule: string, detail: string) => issues.push({ rule, detail });
+  const ts = project.timeSignature;
+  const barT = barTicks(ts);
+  const beatT = beatTicks(ts);
+  const barBeats = barT / beatT;
+  const minTicks = Math.max(1, Math.round(barBeats / 2)) * beatT;
+  const mode = project.mode as ModeName;
+  const keyPc = project.key;
+  const { home, free, borrowed } = buildVocab(mode, keyPc);
+  const allowed = new Map<string, { borrowed: boolean; cadential: boolean }>();
+  for (const c of [...home, ...free, ...borrowed]) allowed.set(`${c.root}:${c.quality}`, { borrowed: c.borrowed, cadential: c.cadential });
+  const tonicQ = home.find((c) => c.root === keyPc && c.fn === 'tonic')?.quality ?? 'major';
+  const deceptive = tonicQ === 'major' ? { root: (keyPc + 9) % 12, quality: 'minor' } : { root: (keyPc + 8) % 12, quality: 'major' };
+
+  const list = chords.filter((c) => !ignoreIds?.has(c.id)).sort((a, b) => a.startTick - b.startTick);
+  const parsed: { c: Chord; p: ParsedChord }[] = [];
+  for (const c of list) {
+    const r = parseChord(c.symbol);
+    if (!r.ok) bad('parse', `${c.symbol}: ${r.error}`);
+    else parsed.push({ c, p: r.chord });
+  }
+  if (!parsed.length) return issues;
+
+  // Tiling: no gaps, no overlaps.
+  for (let i = 0; i < parsed.length; i++) {
+    const { c } = parsed[i];
+    if (c.durationTicks < minTicks) bad('minLength', `${c.symbol}@${c.startTick} holds ${c.durationTicks} ticks < ${minTicks}`);
+    if (c.startTick % beatT !== 0) bad('beatStart', `${c.symbol}@${c.startTick} starts off the felt-beat grid`);
+    if (i > 0) {
+      const prevEnd = parsed[i - 1].c.startTick + parsed[i - 1].c.durationTicks;
+      if (c.startTick < prevEnd) bad('overlap', `${parsed[i - 1].c.symbol} and ${c.symbol} overlap at ${c.startTick}`);
+      else if (c.startTick > prevEnd) bad('gap', `gap between ${parsed[i - 1].c.symbol} and ${c.symbol} at ${prevEnd}`);
+    }
+  }
+  // No direct repeats (same root+quality; C -> C/E counts).
+  for (let i = 1; i < parsed.length; i++) {
+    if (`${parsed[i].p.root}:${parsed[i].p.quality}` === `${parsed[i - 1].p.root}:${parsed[i - 1].p.quality}`)
+      bad('directRepeat', `${parsed[i - 1].c.symbol} -> ${parsed[i].c.symbol}`);
+  }
+  // Key/mode membership, borrowed placement + caps, recurrence per phrase.
+  const sections = [...project.sections].sort((a, b) => a.startBar - b.startBar);
+  for (const section of sections) {
+    const secStart = (section.startBar - 1) * barT;
+    const secEnd = secStart + section.lengthBars * barT;
+    const secChords = parsed.filter((x) => x.c.startTick >= secStart && x.c.startTick < secEnd);
+    const phrases = phraseGrid(secStart, section.lengthBars, barT, false);
+    const borrowCap = Math.max(1, Math.ceil(section.lengthBars / 4));
+    let secBorrow = 0;
+    for (let pi = 0; pi < phrases.length; pi++) {
+      const ph = phrases[pi];
+      const inPhrase = secChords.filter((x) => x.c.startTick >= ph.start && x.c.startTick < ph.end);
+      const rec = new Map<string, number>();
+      let phBorrow = 0;
+      for (let j = 0; j < inPhrase.length; j++) {
+        const { c, p } = inPhrase[j];
+        const key = `${p.root}:${p.quality}`;
+        const info = allowed.get(key);
+        if (!info) { bad('keyMembership', `${c.symbol} (bar ${Math.floor(c.startTick / barT) + 1}) is not diatonic, free or whitelisted in ${mode}`); continue; }
+        const isPhraseEnd = j === inPhrase.length - 1 && Math.abs(c.startTick + c.durationTicks - ph.end) < 1;
+        if (info.borrowed) {
+          secBorrow++; phBorrow++;
+          if (isPhraseEnd) bad('borrowAtPhraseEnd', `${c.symbol} ends a phrase`);
+        }
+        // Cadence check on the phrase-final chord.
+        if (isPhraseEnd) {
+          if (ph.cadence === 'open' && p.root === keyPc) bad('cadence', `${section.name}: phrase ${pi + 1} ends open on tonic ${c.symbol}`);
+          if (ph.cadence === 'resolve' && !(p.root === keyPc || (p.root === deceptive.root && p.quality === deceptive.quality)))
+            bad('cadence', `${section.name}: phrase ${pi + 1} must resolve, ends on ${c.symbol}`);
+          if (ph.cadence === 'finalTonic' && p.root !== keyPc) bad('cadence', `${section.name}: song-final phrase ends on ${c.symbol}`);
+        }
+        rec.set(key, (rec.get(key) ?? 0) + 1);
+      }
+      for (const [key, count] of rec) if (count > 2) bad('recurrence', `${section.name} phrase ${pi + 1}: ${key} appears ${count} times (> 2)`);
+      if (phBorrow > 1) bad('borrowCap', `${section.name} phrase ${pi + 1}: ${phBorrow} borrowed chords`);
+    }
+    if (secBorrow > borrowCap) bad('borrowCap', `${section.name}: ${secBorrow} borrowed chords > ${borrowCap}`);
+  }
+  // Song-level tonic edges (only when the progression spans the song start/end).
+  const songStart = sections.length ? (sections[0].startBar - 1) * barT : 0;
+  const songEndT = sections.length ? (sections[sections.length - 1].startBar - 1 + sections[sections.length - 1].lengthBars) * barT : Infinity;
+  const coversStart = parsed[0].c.startTick === songStart;
+  const coversEnd = parsed[parsed.length - 1].c.startTick + parsed[parsed.length - 1].c.durationTicks >= songEndT;
+  if (coversStart && parsed[0].p.root !== keyPc) bad('tonicFirst', `song starts on ${parsed[0].c.symbol}`);
+  if (coversEnd && parsed[parsed.length - 1].p.root !== keyPc) bad('tonicLast', `song ends on ${parsed[parsed.length - 1].c.symbol}`);
+  return issues;
+}
+
