{
  "id": "uvi-orchestral-suite",
  "name": "UVI Orchestral Suite — string + brass ensembles",
  "description": "One part per UVI Orchestral Suite ensemble patch (strings and, since Phase 8.1, the four Falcon brass patches Crescode writes). Keyswitch names follow the manual's pitchConvention; keyswitchZone is the patch's red zone (silent keys / keyswitch keys, MIDI sounding) and playableLow the patch's lowest playable note — in a profile export any non-keyswitch note below playableLow is dropped (it would trigger a keyswitch or sit in a silent gap); the project itself is never touched. cbLayer omit (the default) leaves the Cb octave doubles out of the export entirely — the Cello Ensemble carries the cellosBasses track and no Bass part or file is created; 'separate' gives the layer:'cb' doubles their own Bass Ensemble part on its own channel/file. Brass parts use the 4-horn layer only; the 8-horn and Xtra layers are ignored.",
  "pitchConvention": "C3=60",
  "keyswitchVelocity": 100,
  "cbLayer": "omit",
