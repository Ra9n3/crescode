+++ b/tests/chordgen.test.ts
@@ -0,0 +1,376 @@
+import { describe, expect, it } from 'vitest';
+import { parseChord, type ParsedChord } from '../src/shared/schema/chords';
+import { barTicks } from '../src/shared/schema/meter';
+import { MODES } from '../src/shared/schema/modes';
+import { validateProject } from '../src/shared/schema/validate';
+import {
+  auditProgression, chordTension, generateProgression, generateProgressionDetailed, resolveProfileKey,
+  type GenScope,
+} from '../src/orchestrator/chordgen';
+import { useStore } from '../src/store/store';
+import type { Chord, Project, Section } from '../src/shared/schema/types';
+
+const P = (s: string): ParsedChord => {
+  const r = parseChord(s);
+  if (!r.ok) throw new Error(`test helper: ${s} does not parse`);
+  return r.chord;
+};
+
+/* ---------- helpers ---------- */
+
+let idc = 0;
+const sec = (name: string, startBar: number, lengthBars: number): Section =>
+  ({ id: `s${idc++}`, name, startBar, lengthBars });
+
+function makeProject(sections: Section[], opts: { key?: number; mode?: Project['mode']; ts?: Project['timeSignature']; chords?: Chord[] } = {}): Project {
+  const timeSignature = opts.ts ?? { numerator: 4, denominator: 4 };
+  return {
+    schemaVersion: 1,
+    name: 'test',
+    bpm: 100,
+    tempoMap: [{ tick: 0, bpm: 100 }],
+    timeSignature,
+    key: opts.key ?? 2, // D
+    mode: opts.mode ?? 'Dorian',
+    sections,
+    chords: opts.chords ?? [],
+    referenceAudio: { path: null, offsetMs: 0 },
+    tracks: [],
+    libraryGroups: [],
+    masterVolume: 1,
+  };
+}
+
+const barT = (p: Project) => barTicks(p.timeSignature);
+const keyOf = (c: Chord) => { const r = P(c.symbol); return `${r.root}:${r.quality}`; };
+
+const STANDARD = [sec('Verse', 1, 8), sec('Chorus', 9, 8)];
+
+/* Five structures for the seed harness (spec §6). */
+const STRUCTURES: { name: string; project: () => Project }[] = [
+  { name: 'classic form', project: () => makeProject([sec('Intro', 1, 4), sec('Verse', 5, 8), sec('Pre-Chorus', 13, 4), sec('Chorus', 17, 8), sec('Verse', 25, 8), sec('Chorus', 33, 8), sec('Outro', 41, 4)]) },
+  { name: 'single 16-bar verse', project: () => makeProject([sec('Verse', 1, 16)]) },
+  { name: 'full suite', project: () => makeProject([sec('Intro', 1, 4), sec('Verse', 5, 8), sec('Pre-Chorus', 13, 4), sec('Chorus', 17, 8), sec('Bridge', 25, 4), sec('Chorus', 29, 8), sec('Outro', 37, 4)]) },
+  { name: 'odd lengths', project: () => makeProject([sec('Intro', 1, 2), sec('Verse', 3, 5), sec('Chorus', 8, 7), sec('Bridge', 15, 3), sec('Outro', 18, 3)]) },
+  {
+    name: 'scattered locks', project: () => {
+      const bt = barTicks({ numerator: 4, denominator: 4 });
+      const p = makeProject([sec('Verse', 1, 8), sec('Chorus', 9, 8)]);
+      p.chords = [
+        { id: 'lockA', symbol: 'Dm', startTick: 1 * bt, durationTicks: 2 * bt, locked: true },  // bars 2-3
+        { id: 'lockB', symbol: 'F', startTick: 10 * bt, durationTicks: 2 * bt, locked: true },  // bars 11-12
+      ];
+      return p;
+    },
+  },
+];
+
+/* ---------- Rule 34: tension metric ---------- */
+
+describe('chord tension metric (Rule 34, formalized)', () => {
+  it('reproduces the published worked examples', () => {
+    const D = 2;
+    expect(chordTension(P('Dm'), D)).toBeCloseTo(0.00, 2);
+    expect(chordTension(P('G7'), D)).toBeCloseTo(0.46, 2);
+    expect(chordTension(P('A7b9'), D)).toBeCloseTo(0.75, 2);
+  });
+  it('orders tension sensibly across chord classes', () => {
+    const D = 2;
+    const T = (s: string) => chordTension(P(s), D);
+    expect(T('Dm')).toBeLessThan(T('G7'));
+    expect(T('G7')).toBeLessThan(T('A7b9'));
+    expect(T('Dm')).toBeLessThan(T('Bbmaj7'));
+  });
+});
+
+/* ---------- core invariants ---------- */
+
+describe('progression generator — core invariants', () => {
+  it('determinism: same seed -> identical content; different seed -> different content', () => {
+    const p = makeProject(STANDARD);
+    const strip = (list: Chord[]) => list.map((c) => `${c.symbol}@${c.startTick}+${c.durationTicks}`).join('|');
+    const a = generateProgression(p, { seed: 42, scope: 'all' });
+    const b = generateProgression(p, { seed: 42, scope: 'all' });
+    const c = generateProgression(p, { seed: 7, scope: 'all' });
+    expect(strip(a)).toBe(strip(b)); // ids carry a run-local counter; content is what must match
+    expect(strip(a)).not.toBe(strip(c));
+  });
+
+  it('every emitted symbol parses; chords tile every section exactly', () => {
+    const p = makeProject([sec('Intro', 1, 4), sec('Verse', 5, 8), sec('Pre-Chorus', 13, 4), sec('Chorus', 17, 8), sec('Bridge', 25, 4), sec('Outro', 29, 4)]);
+    p.chords = generateProgression(p, { seed: 11, scope: 'all' });
+    expect(p.chords.length).toBeGreaterThan(4);
+    const bt = barT(p);
+    for (const s of p.sections) {
+      const list = p.chords.filter((c) => c.startTick >= (s.startBar - 1) * bt && c.startTick < (s.startBar - 1 + s.lengthBars) * bt);
+      const start = (s.startBar - 1) * bt, end = start + s.lengthBars * bt;
+      expect(list.length, s.name).toBeGreaterThan(0);
+      let t = start;
+      for (const c of list.sort((a, b) => a.startTick - b.startTick)) {
+        expect(c.startTick).toBe(t);          // no gaps, no overlaps
+        expect(c.startTick % (bt / 4)).toBe(0); // on felt beats
+        expect(parseChord(c.symbol).ok, c.symbol).toBe(true);
+        t = c.startTick + c.durationTicks;
+      }
+      expect(t, s.name).toBe(end);
+    }
+  });
+
+  it('minimum chord length is half a bar (rounded to whole beats); starts on felt beats', () => {
+    const p = makeProject(STANDARD);
+    const bt = barT(p);
+    const minTicks = Math.max(1, Math.round(4 / 2)) * (bt / 4);
+    p.chords = generateProgression(p, { seed: 3, scope: 'all' });
+    for (const c of p.chords) {
+      expect(c.durationTicks, `${c.symbol}@${c.startTick}`).toBeGreaterThanOrEqual(minTicks);
+      expect(c.startTick % (bt / 4)).toBe(0);
+    }
+  });
+
+  it('tonic opens the song and closes it (scope touches start/end)', () => {
+    const p = makeProject(STANDARD);
+    p.chords = generateProgression(p, { seed: 21, scope: 'all' });
+    const sorted = [...p.chords].sort((a, b) => a.startTick - b.startTick);
+    expect(P(sorted[0].symbol).root).toBe(p.key);
+    expect(P(sorted[sorted.length - 1].symbol).root).toBe(p.key);
+  });
+
+  it('no direct repeats anywhere — same root+quality, so C -> C/E counts as a repeat', () => {
+    const p = makeProject([sec('Verse', 1, 8), sec('Pre-Chorus', 9, 4), sec('Chorus', 13, 8)]);
+    p.chords = generateProgression(p, { seed: 4, scope: 'all' });
+    const keys = p.chords.sort((a, b) => a.startTick - b.startTick).map(keyOf);
+    for (let i = 1; i < keys.length; i++) expect(keys[i], `repeat at index ${i}`).not.toBe(keys[i - 1]);
+  });
+
+  it('phrase cadences: mid-song phrases end open, section ends resolve, song ends on tonic', () => {
+    const p = makeProject([sec('Verse', 1, 8), sec('Chorus', 9, 8), sec('Outro', 17, 4)]);
+    p.chords = generateProgression(p, { seed: 17, scope: 'all' });
+    const bt = barT(p);
+    const sorted = [...p.chords].sort((a, b) => a.startTick - b.startTick);
+    const issues = auditProgression(p, sorted);
+    expect(issues, issues.map((i) => `${i.rule}: ${i.detail}`).join('; ')).toEqual([]);
+    // Explicit: every 4-bar phrase boundary lands on the right cadence family.
+    const endAt = (tick: number) => sorted.find((c) => c.startTick + c.durationTicks === tick);
+    for (const phraseEnd of [4, 8, 12, 16, 20]) {
+      const c = endAt(phraseEnd * bt);
+      expect(c, `phrase end at bar ${phraseEnd + 1}`).toBeDefined();
+      if (phraseEnd === 20) expect(P(c!.symbol).root, 'song end').toBe(p.key);
+    }
+  });
+
+  it("scope 'empty' preserves every existing chord and fills only the gaps", () => {
+    const p = makeProject(STANDARD);
+    const bt = barT(p);
+    const existing: Chord[] = [
+      { id: 'keep1', symbol: 'Dm', startTick: 0, durationTicks: 2 * bt },
+      { id: 'keep2', symbol: 'Gm', startTick: 8 * bt, durationTicks: bt },
+    ];
+    p.chords = existing;
+    const out = generateProgression(p, { seed: 9, scope: 'empty' });
+    for (const k of existing) {
+      const kept = out.find((c) => c.id === k.id);
+      expect(kept?.symbol, k.id).toBe(k.symbol);
+      expect(kept?.startTick).toBe(k.startTick);
+      expect(kept?.durationTicks).toBe(k.durationTicks);
+    }
+    for (const c of out) {
+      if (c.id === 'keep1' || c.id === 'keep2') continue;
+      for (const k of existing) expect(c.startTick < k.startTick + k.durationTicks && c.startTick + c.durationTicks > k.startTick, `${c.symbol} overlaps kept`).toBe(false);
+    }
+    expect(out.length).toBeGreaterThan(existing.length);
+    const issues = auditProgression(p, out);
+    expect(issues, issues.map((i) => `${i.rule}: ${i.detail}`).join('; ')).toEqual([]);
+  });
+
+  it("scope 'empty' with no empty areas is a no-op", () => {
+    const p = makeProject([sec('Verse', 1, 4)]);
+    const bt = barT(p);
+    p.chords = [
+      { id: 'a', symbol: 'Dm', startTick: 0, durationTicks: 2 * bt },
+      { id: 'b', symbol: 'Gm', startTick: 2 * bt, durationTicks: 2 * bt },
+    ];
+    const out = generateProgression(p, { seed: 5, scope: 'empty' });
+    expect(out).toEqual(p.chords);
+  });
+
+  it("scope 'section' changes only the chosen section", () => {
+    const p = makeProject(STANDARD);
+    p.chords = generateProgression(p, { seed: 30, scope: 'all' });
+    const before = p.chords.filter((c) => c.startTick >= 8 * barT(p));
+    p.chords = generateProgression(p, { seed: 31, scope: 'section', sectionId: p.sections[0].id });
+    const after = p.chords.filter((c) => c.startTick >= 8 * barT(p));
+    expect(JSON.stringify(after)).toBe(JSON.stringify(before));
+  });
+
+  it('locked chords are never touched by Whole-song generation', () => {
+    const bt = barT(makeProject([]));
+    const p = makeProject(STANDARD);
+    p.chords = [{ id: 'lockX', symbol: 'Bbmaj7', startTick: 3 * bt, durationTicks: 2 * bt, locked: true }];
+    const out = generateProgression(p, { seed: 6, scope: 'all' });
+    const kept = out.find((c) => c.id === 'lockX');
+    expect(kept?.symbol).toBe('Bbmaj7');
+    expect(kept?.locked).toBe(true);
+    for (const c of out) {
+      if (c.id === 'lockX') continue;
+      expect(c.startTick < 5 * bt && c.startTick + c.durationTicks > 3 * bt, 'generated overlaps locked').toBe(false);
+    }
+  });
+});
+
+/* ---------- re-roll ---------- */
+
+describe('re-roll one section', () => {
+  it('leaves every other section byte-identical and keeps both boundaries repeat-free', () => {
+    const p = makeProject([...STANDARD, sec('Outro', 17, 4)]);
+    const base = generateProgression(p, { seed: 42, scope: 'all' });
+    p.chords = base; // the re-roll must see the base progression as existing chords
+    const bt = barT(p);
+    const chorus = p.sections[1], outro = p.sections[2];
+    const chorusBefore = base.filter((c) => c.startTick >= 8 * bt && c.startTick < 16 * bt);
+    const outroBefore = base.filter((c) => c.startTick >= 16 * bt);
+    const verseBefore = base.filter((c) => c.startTick < 8 * bt);
+
+    const rerolled = generateProgression(p, { seed: 777, rerollSectionId: p.sections[0].id });
+    const verseAfter = rerolled.filter((c) => c.startTick < 8 * bt);
+    const chorusAfter = rerolled.filter((c) => c.startTick >= 8 * bt && c.startTick < 16 * bt);
+    const outroAfter = rerolled.filter((c) => c.startTick >= 16 * bt);
+    expect(JSON.stringify(chorusAfter)).toBe(JSON.stringify(chorusBefore)); // siblings untouched
+    expect(JSON.stringify(outroAfter)).toBe(JSON.stringify(outroBefore));
+    expect(JSON.stringify(verseAfter)).not.toBe(JSON.stringify(verseBefore)); // it actually re-rolled
+
+    // Boundary walls: no direct repeat into the previous or next neighbour.
+    const lastOf = (list: Chord[]) => [...list].sort((a, b) => a.startTick - b.startTick).slice(-1)[0];
+    const firstOf = (list: Chord[]) => [...list].sort((a, b) => a.startTick - b.startTick)[0];
+    expect(keyOf(lastOf(verseAfter))).not.toBe(keyOf(firstOf(chorusAfter)));
+    expect(keyOf(lastOf(chorusAfter))).not.toBe(keyOf(firstOf(outroAfter)));
+
+    const issues = auditProgression(p, rerolled);
+    expect(issues, issues.map((i) => `${i.rule}: ${i.detail}`).join('; ')).toEqual([]);
+  });
+
+  it('re-roll respects locks inside the section', () => {
+    const bt = barT(makeProject([]));
+    const p = makeProject([sec('Verse', 1, 8), sec('Chorus', 9, 8)]);
+    p.chords = [{ id: 'lockZ', symbol: 'Cmaj7', startTick: 5 * bt, durationTicks: 2 * bt, locked: true }];
+    generateProgression(p, { seed: 8, scope: 'all' });
+    const out = generateProgression(p, { seed: 999, rerollSectionId: p.sections[0].id });
+    const kept = out.find((c) => c.id === 'lockZ');
+    expect(kept?.symbol).toBe('Cmaj7');
+    for (const c of out) {
+      if (c.id === 'lockZ') continue;
+      expect(c.startTick < 7 * bt && c.startTick + c.durationTicks > 5 * bt, 're-roll overlaps locked').toBe(false);
+    }
+  });
+});
+
+/* ---------- locks & persistence ---------- */
+
+describe('chord locks — persistence', () => {
+  it('locks survive a save/load JSON roundtrip and validation accepts old files without the field', () => {
+    const p = makeProject(STANDARD);
+    p.chords = [
+      { id: 'new', symbol: 'Dm', startTick: 0, durationTicks: 2 * barT(p), locked: true },
+      { id: 'old', symbol: 'Gm', startTick: 2 * barT(p), durationTicks: 2 * barT(p) }, // legacy: no locked field
+    ];
+    const roundtrip = JSON.parse(JSON.stringify(p)) as Project;
+    const v = validateProject(roundtrip);
+    expect(v.ok, v.ok ? '' : v.errors.map((e) => `${e.path}: ${e.message}`).join('; ')).toBe(true);
+    expect(roundtrip.chords.find((c) => c.id === 'new')?.locked).toBe(true);
+    expect(roundtrip.chords.find((c) => c.id === 'old')?.locked).toBeUndefined(); // missing means unlocked
+  });
+
+  it('locks survive undo of a Generate (store-level)', () => {
+    const bt = barT(makeProject([]));
+    const p = makeProject(STANDARD);
+    p.chords = [{ id: 'lockU', symbol: 'Dm', startTick: 0, durationTicks: 2 * bt, locked: true }];
+    useStore.getState().loadProject(JSON.parse(JSON.stringify(p)));
+    const st = useStore.getState();
+    st.generateProgression({ seed: 12, scope: 'all' });
+    const afterGen = st.project.chords.find((c) => c.id === 'lockU');
+    expect(afterGen?.symbol).toBe('Dm'); // untouched by generate
+    st.set({ modal: null });
+    st.undo();
+    const afterUndo = useStore.getState().project.chords.find((c) => c.id === 'lockU');
+    expect(afterUndo?.locked).toBe(true);
+    expect(afterUndo?.symbol).toBe('Dm');
+  });
+});
+
+/* ---------- structure coverage ---------- */
+
+describe('structure coverage', () => {
+  it('sections shorter than 4 bars, leftovers and a single-section song all pass', () => {
+    for (const len of [1, 2, 3, 5, 7]) {
+      const p = makeProject([sec('Verse', 1, len), sec('Chorus', len + 1, 4)]);
+      const out = generateProgression(p, { seed: 13 + len, scope: 'all' });
+      const issues = auditProgression(p, out);
+      expect(issues, `verse of ${len} bars: ${issues.map((i) => `${i.rule}: ${i.detail}`).join('; ')}`).toEqual([]);
+    }
+    const single = makeProject([sec('Verse', 1, 8)]);
+    const singleIssues = auditProgression(single, generateProgression(single, { seed: 2, scope: 'all' }));
+    expect(singleIssues, singleIssues.map((i) => `${i.rule}: ${i.detail}`).join('; ')).toEqual([]);
+  });
+
+  it('generates for all 12 modes with every hard rule intact', () => {
+    for (const mode of Object.keys(MODES) as Project['mode'][]) {
+      const p = makeProject(STANDARD, { mode });
+      const out = generateProgression(p, { seed: 77, scope: 'all' });
+      expect(out.length, mode).toBeGreaterThan(4);
+      const issues = auditProgression(p, out);
+      expect(issues, `${mode}: ${issues.map((i) => `${i.rule}: ${i.detail}`).join('; ')}`).toEqual([]);
+    }
+  });
+
+  it('different key centre (Ab Ionian) passes as well', () => {
+    const p = makeProject([sec('Verse', 1, 8), sec('Chorus', 9, 8)], { key: 8, mode: 'Ionian' });
+    const issues = auditProgression(p, generateProgression(p, { seed: 55, scope: 'all' }));
+    expect(issues, issues.map((i) => `${i.rule}: ${i.detail}`).join('; ')).toEqual([]);
+  });
+});
+
+/* ---------- the seed harness (spec §6: 1000 seeds x >= 5 structures) ---------- */
+
+describe('seed harness — 1000 seeds x 5 structures', () => {
+  it('every seed in every structure passes all hard rules; fallbacks counted and reported', () => {
+    let fallbacks = 0, sectionsAudited = 0;
+    for (const { name, project } of STRUCTURES) {
+      for (let seed = 1; seed <= 1000; seed++) {
+        const p = project();
+        const { chords, reports, fallbackCount } = generateProgressionDetailed(p, { seed, scope: 'all' });
+        fallbacks += fallbackCount;
+        sectionsAudited += reports.length;
+        const issues = auditProgression(p, chords);
+        if (issues.length) {
+          throw new Error(`${name} seed ${seed}: ${issues.map((i) => `${i.rule}: ${i.detail}`).join('; ')}`);
+        }
+      }
+    }
+    const rate = fallbacks / sectionsAudited;
+    // Provisional ceiling until the floor is calibrated by ear (user decision #9).
+    expect(rate, `fallback rate ${(rate * 100).toFixed(2)}% (${fallbacks}/${sectionsAudited})`).toBeLessThan(0.2);
+    console.log(`[seed-harness] fallback rate: ${(rate * 100).toFixed(2)}% (${fallbacks}/${sectionsAudited} sections)`);
+  }, 600_000);
+});
+
+/* ---------- profile routing ---------- */
+
+describe('profile routing picks sensible section keys', () => {
+  it('maps section names to profiles', () => {
+    expect(resolveProfileKey('Intro')).toBe('intro');
+    expect(resolveProfileKey('Pre-Chorus')).toBe('prechorus');
+    expect(resolveProfileKey('Build Up')).toBe('build');
+    expect(resolveProfileKey('chorus 2')).toBe('chorus');
+    expect(resolveProfileKey('Breakdown')).toBe('breakdown');
+    expect(resolveProfileKey('Mosh Pit')).toBe('verse');
+  });
+
+  it('default scope is "empty areas only" (user decision #3)', () => {
+    const p = makeProject(STANDARD);
+    const bt = barT(p);
+    p.chords = [{ id: 'only', symbol: 'Dm', startTick: 0, durationTicks: 2 * bt }];
+    const withDefault = generateProgression(p, { seed: 3 });
+    expect(withDefault.find((c) => c.id === 'only')?.symbol).toBe('Dm');
+    const genScopes: GenScope[] = ['empty', 'all', 'section'];
+    expect(genScopes[0]).toBe('empty');
+  });
+});
