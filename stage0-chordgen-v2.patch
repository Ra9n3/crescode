+    for (let i = 1; i < perBar.length; i++) expect(perBar[i].t).toBeGreaterThanOrEqual(perBar[i - 1].t - 1e-6);
+    expect(perBar[perBar.length - 1].t).toBeGreaterThanOrEqual(perBar[0].t + 0.12);
+  });
